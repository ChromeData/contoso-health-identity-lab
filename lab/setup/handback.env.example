# Copy to lab/setup/handback.env (gitignored) and fill in after the sign-ups
# in SIGNUP-KIT.md. Identifiers only: NO passwords, NO tokens, NO keys here.
#   Okta API token  -> export OKTA_API_TOKEN=... in your shell
#   AWS             -> an SSO profile (aws configure sso --profile idlab-admin)

# ---- 1. Microsoft 365 E5 trial ----
ONMICROSOFT_DOMAIN=contosohealthlab7f3a.onmicrosoft.com
ADMIN_UPN=admin@contosohealthlab7f3a.onmicrosoft.com
LAB_SUFFIX=7f3a            # the four characters you put in the domain; used for globally unique names

# ---- 3. Azure ----
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus2

# ---- 4. Okta Integrator Free ----
OKTA_ORG_NAME=integrator-1234567
OKTA_BASE_URL=okta.com
CLINIC_LOGIN_DOMAIN=clinic.contoso.example

# ---- 5. AWS ----
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_PROFILE=idlab-admin
AWS_ACCESS_PORTAL_URL=https://d-xxxxxxxxxx.awsapps.com/start

# ---- 6. ServiceNow ----
SERVICENOW_INSTANCE_URL=https://devNNNNNN.service-now.com

# ---- You ----
OPERATOR_IP=203.0.113.7          # curl -s https://ifconfig.me
ALERT_EMAIL=you@example.com
GITHUB_OWNER=ChromeData
GITHUB_REPO=contoso-health-identity-lab

# ---- Optional: Azure OpenAI for the PR AI review (ai-review.yml) ----
# AZURE_OPENAI_RESOURCE_ID=/subscriptions/.../providers/Microsoft.CognitiveServices/accounts/oai-idlab-7f3a
# AZURE_OPENAI_ENDPOINT=https://oai-idlab-7f3a.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
