// =============================================================================
// Detection: Credential added to an application or service principal
// Lab:       Contoso Health Identity Platform  (lab/ - ITDR pack)
// -----------------------------------------------------------------------------
// WHAT IT CATCHES
//   A NEW secret, certificate or federated identity credential (FIC) on an app
//   registration or a service principal. A credential on a workload identity
//   is how an attacker who reached an app-admin role keeps access after the
//   compromised user is reset: the app signs in on its own, with no MFA and no
//   user Conditional Access policy in the way (the Solorigate 2020 and Midnight
//   Blizzard 2024 persistence pattern). Three audit shapes:
//     "Add service principal credentials"  -> key on the SERVICE PRINCIPAL
//        object. It never shows in the App registrations blade, which is
//        exactly why attackers prefer it.
//     "Update application - Certificates and secrets management"
//                                           -> key on the app registration
//     "Update application" whose modified property is
//        FederatedIdentityCredentials       -> a new OIDC trust (e.g. another
//        GitHub repo or branch allowed to mint tokens as the app - the lab's
//        own pipeline identities are FIC-based, see modules/pipeline-identity)
//   Only ADDITIONS alert: the query diffs old vs new credential lists, so a
//   removal or an unchanged list (a description edit) returns nothing.
//
// SEVERITY (dynamic - the Severity column drives the Sentinel alert)
//   High   : credential on a ServicePrincipal object, or a new FIC, by anyone
//            other than the CI apply identity.
//   Medium : secret / certificate on an app registration by a human or app.
//   Low    : the change came from the CI apply identity, matched by its
//            immutable service principal / app id (a reviewed PR). Still
//            alerted, never suppressed. An app that only CARRIES the IaC
//            display name is High (IacNameSpoof).
//
// TABLE / SOURCE
//   AuditLogs (Entra diagnostic setting -> loga-idlab), Category
//   "ApplicationManagement". The key list lives in modifiedProperties
//   "KeyDescription" as strings like
//     [KeyIdentifier=<guid>,KeyType=Password,KeyUsage=Verify,DisplayName=<x>]
//   verify: the FederatedIdentityCredentials modifiedProperty name and value
//   shape (JSON objects with Issuer / Subject) on the first FIC change made in
//   the lab tenant; the KeyDescription format matches Microsoft's own
//   "New access credential added to Application or Service Principal" rule.
//
// LICENSE
//   AuditLogs export: any Entra tier with a Log Analytics workspace (P1 for
//   sign-in logs, not needed here). Sentinel optional (31-day trial).
//
// MITRE ATT&CK
//   T1098.001 Account Manipulation: Additional Cloud Credentials
//   Tactics: Persistence, PrivilegeEscalation
//   (Sentinel's techniques field takes parent ids only - T1098 - so the
//   sub-technique is recorded here and in the rule description.)
//
// FALSE-POSITIVE NOTES
//   - Planned secret rotation by an app owner (Medium). Rotation SHOULD move to
//     certificates or FICs owned by IaC; every human rotation is worth a look.
//   - The CI apply identity's own changes (Low) - match them to the PR.
//   - IacPrincipalIds is rendered by modules/monitoring from the APPLY
//     identity's ids. Run standalone (empty list) every CI change is Medium
//     or High - expected; a High with IacNameSpoof = true is NOT benign.
//
// SUGGESTED SENTINEL RULE (deployed by lab/terraform/modules/monitoring when
// enable_itdr_detections and enable_sentinel are both true)
//   Frequency 5m · Lookback 1h · Trigger > 0 rows · one alert per row ·
//   Severity from the Severity column · Entities: Account = ActorUpn /
//   ActorObjectId, IP = ActorIp · incidents grouped per Account + severity.
//
// AUTOMATED RESPONSE
//   Every incident: lab/monitoring/playbook-notify.json (Teams card +
//   ServiceNow). High incidents also: lab/monitoring/playbook-contain.json
//   (Teams APPROVAL card -> revoke sessions / disable the actor) once
//   enable_itdr_containment is on. The credential itself is NOT removed by the
//   playbook: deleting a key can break a production integration, so that call
//   stays with the app owner (runbook step).
// =============================================================================

let LookBack = 1h;
// The CI apply identity, matched on IMMUTABLE ids (service principal object
// id / application client id), never on its display name: anyone who owns or
// administers an app can rename it "gh-oidc-entra-apply (write)", and a
// display-name match would DOWNGRADE that attacker's changes.
// modules/monitoring renders the list from var.iac_principal_ids (envs/
// bootstrap output iac_principal_ids). Committed, it is empty: run as-is,
// nothing counts as IaC - fail closed, severity can only go up.
let IacPrincipalIds = dynamic(["66666666-6666-6666-6666-666666666666"]); // @@IAC_PRINCIPAL_IDS@@
let IacDisplayName = "gh-oidc-entra-apply (write)"; // impersonation check ONLY, never trust
AuditLogs
| where TimeGenerated > ago(LookBack)
| where Category == "ApplicationManagement"
| where Result =~ "success"
| where OperationName has_any ("Add service principal credentials", "Certificates and secrets management")
     or (OperationName =~ "Update application" and tostring(TargetResources) has "FederatedIdentityCredentials")
| extend ActorUpn      = tostring(InitiatedBy.user.userPrincipalName)
| extend ActorObjectId = tostring(InitiatedBy.user.id)
| extend ActorApp      = tostring(InitiatedBy.app.displayName)
| extend ActorAppSpId  = tostring(InitiatedBy.app.servicePrincipalId)
| extend ActorIp       = iff(isnotempty(tostring(InitiatedBy.user.ipAddress)),
                             tostring(InitiatedBy.user.ipAddress),
                             tostring(InitiatedBy.app.ipAddress))
| extend Actor         = iff(isnotempty(ActorUpn), ActorUpn, ActorApp)
// The changed object, picked by TYPE (TargetResources order is not guaranteed).
| mv-apply tr = TargetResources on (
    where tostring(tr.type) in~ ("Application", "ServicePrincipal")
    | take 1
    | extend TargetName     = tostring(tr.displayName),
             TargetObjectId = tostring(tr.id),
             TargetType     = tostring(tr.type),
             ModProps       = tr.modifiedProperties
  )
// Old and new credential lists (JSON text inside the audit record).
| mv-apply mp = ModProps on (
    where tostring(mp.displayName) in~ ("KeyDescription", "FederatedIdentityCredentials")
    | summarize ChangedProperty = take_any(tostring(mp.displayName)),
                OldValue        = take_any(tostring(mp.oldValue)),
                NewValue        = take_any(tostring(mp.newValue))
  )
| where isnotempty(ChangedProperty)
| extend OldSet = parse_json(OldValue), NewSet = parse_json(NewValue)
// Elements compared as text, so key strings and FIC objects diff the same way.
// tostring() CONVERTS each element (an object becomes its JSON text). Not
// "mv-apply ... to typeof(string)": Learn (mv-expand) says that typing is
// cast-only - "array elements that don't conform with the declared type
// become null values" - so every FIC object would turn into null and no new
// FIC would ever count as added.
| mv-apply o = OldSet on (
    summarize OldStrings = make_list(tostring(o))
  )
| mv-apply n = NewSet on (
    extend ns = tostring(n)
    | where not(set_has_element(OldStrings, ns))
    | summarize Added      = make_list(ns),
                KeyTypes   = make_set(extract(@"KeyType=([^,\]]+)", 1, ns)),
                FicIssuers = make_set(extract(@'"[Ii]ssuer"\s*:\s*"([^"]+)"', 1, ns)),
                FicSubject = make_set(extract(@'"[Ss]ubject"\s*:\s*"([^"]+)"', 1, ns))
  )
| extend AddedCount = array_length(Added)
| where AddedCount > 0
| extend KeyTypes   = set_difference(KeyTypes, dynamic([""])),
         FicIssuers = set_difference(FicIssuers, dynamic([""])),
         FicSubject = set_difference(FicSubject, dynamic([""]))
| extend CredentialKind = case(
    ChangedProperty =~ "FederatedIdentityCredentials", "FederatedIdentityCredential",
    set_has_element(KeyTypes, "Password"),              "ClientSecret",
    set_has_element(KeyTypes, "AsymmetricX509Cert"),    "Certificate",
    "Other")
| extend FirstCredential = array_length(OldStrings) == 0
| extend ActorSpId  = tostring(InitiatedBy.app.servicePrincipalId)
| extend ActorAppId = tostring(InitiatedBy.app.appId)
| extend IsIac = (isnotempty(ActorSpId) and ActorSpId in (IacPrincipalIds))
              or (isnotempty(ActorAppId) and ActorAppId in (IacPrincipalIds))
// The IaC name on an app that is NOT the IaC identity = someone impersonating
// the pipeline to look routine. Always High.
| extend IacNameSpoof = not(IsIac) and ActorApp =~ IacDisplayName
| extend Severity = case(
    IacNameSpoof, "High",
    IsIac, "Low",
    TargetType =~ "ServicePrincipal" or CredentialKind == "FederatedIdentityCredential", "High",
    "Medium")
| project TimeGenerated, Severity, Actor, ActorUpn, ActorObjectId, ActorApp, ActorAppSpId,
          ActorIp, IsIac, IacNameSpoof, OperationName, TargetType, TargetName, TargetObjectId,
          CredentialKind, KeyTypes, FicIssuers, FicSubject, AddedCount, FirstCredential,
          CorrelationId
| sort by TimeGenerated desc
