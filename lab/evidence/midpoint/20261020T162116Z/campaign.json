    "scopeDefinition" : {
      "@type" : "c:AccessCertificationAssignmentReviewScopeType",
      "name" : "Requestable business roles of enabled users",
      "objectType" : "c:UserType",
      "searchFilter" : {
        "text" : "activation/effectiveStatus = \"enabled\""
      },
      "itemSelectionExpression" : {
        "script" : [ {
          "code" : "\n                    // Only requestable business roles (ADR 0012 T2). Birthright roles (T3)\n                    // and midPoint's built-in system roles stay out of the campaign.\n                    def ref = assignment?.targetRef\n                    if (ref == null || ref.oid == null) {\n                        return false\n                    }\n                    def role = midpoint.getObject(com.evolveum.midpoint.xml.ns._public.common.common_3.RoleType.class, ref.oid)\n                    def businessRole = role.getArchetypeRef().any { it.oid == '00000000-0000-0000-0000-000000000321' }\n                    return businessRole && Boolean.TRUE.equals(role.isRequestable())\n                "
        } ]
      },
      "includeAssignments" : true,
