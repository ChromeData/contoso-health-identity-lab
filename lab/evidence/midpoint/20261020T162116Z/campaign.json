    "name" : "Contoso T2 requestable-access review 14",
    "description" : "ADR 0012 tier T2, the branch for requestable access with NO expiry (these role assignments carry no validTo, so the 180-day expiry that normally certifies T2 does not apply): requestable business roles, manager review, unanswered = removed. The halfyearly cadence and mandatory justification are not modelled in this one-off run. Managed by run-campaign.sh.",
    "iteration" : 1,
    "definitionRef" : {
      "oid" : "c0471e00-0000-4000-8000-000000000401",
      "relation" : "org:default",
      "type" : "c:AccessCertificationDefinitionType"
    },
