#!/usr/bin/env bash
# =============================================================================
# bot-gh - run `gh` or `git` as the lab's GitHub App (the bot), not as the owner
# -----------------------------------------------------------------------------
# Why (karen-review A1): AI coding agents used the owner's own `gh` login
# (ChromeData) to push, open PRs and merge. Then GitHub cannot tell the author
# from the approver. With this wrapper the agents act as the App's bot account
# "<slug>[bot]", and the owner stays the only human who approves an apply.
# The apply gate (.github/scripts/apply-approval-gate.sh) enforces it once repo
# Variable APPLY_BOT_LOGIN is set to "<slug>[bot]": the PR author and merger
# must be the bot, and the approver must be someone else.
#
#   bot-gh whoami                      # App slug, bot login, installation id
#   bot-gh gh pr create --base main ...# any gh command, as the bot
#   bot-gh git commit -m "..."         # commit with the bot as author+committer
#   bot-gh git push origin-https HEAD  # push over HTTPS with the bot's token
#                                      # (SSH remotes are refused: they would
#                                      # push with the owner's SSH key)
#   bot-gh push <branch>               # shortcut: push HEAD to <branch> as the bot
#
# How: the App private key's only lasting copy is the login Keychain item
# $BOT_KEYCHAIN_SERVICE (base64 PEM, written by new-bot-app.sh). Each call:
#   1. reads the key into a shell variable (never argv, never a file),
#   2. signs a 9-minute App JWT with openssl (key passed on a pipe),
#   3. exchanges it for a 1-hour installation token scoped to THIS repo only,
#   4. passes the token to gh / git in the environment (GH_TOKEN, or a git
#      credential helper reading $BOT_TOKEN, answered for https://github.com
#      only). Never in argv, never printed.
# curl gets its Authorization header from a config on stdin (-K -), so the
# JWT and token never show in `ps`.
#
# What the bot can do is set by the App's permissions (new-bot-app.sh):
# contents, pull requests and workflows write; issues READ only, so the bot
# cannot even comment on an "Approve: apply" issue. It has no Azure, Entra or
# AWS rights: GitHub roles and Entra roles are separate systems.
# =============================================================================
set -euo pipefail

BOT_HOME="${CONTOSO_OPERATOR_HOME:-$HOME/.contoso-operator}"
BOT_ENV="$BOT_HOME/bot.env"                  # ids only, no secret
BOT_KEYCHAIN_SERVICE="${BOT_KEYCHAIN_SERVICE:-contoso-lab-bot-key}"
GITHUB_API="${GITHUB_API:-https://api.github.com}"

die() { echo "bot-gh: $*" >&2; exit 1; }

[ -f "$BOT_ENV" ] || die "no $BOT_ENV yet - the owner runs new-bot-app.sh once (see README.md)"
# shellcheck disable=SC1090
. "$BOT_ENV"
for v in BOT_APP_ID BOT_SLUG BOT_REPO BOT_USER_ID; do
  [ -n "${!v:-}" ] || die "$v missing from $BOT_ENV"
done
BOT_LOGIN="${BOT_SLUG}[bot]"
BOT_EMAIL="${BOT_USER_ID}+${BOT_LOGIN}@users.noreply.github.com"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# curl with a bearer header that never reaches argv: the header line is a
# curl config fed on stdin. $1 = method, $2 = URL path, $3 = token, [$4 = body]
api() {
  local method="$1" path="$2" auth="$3" body="${4:-}"
  {
    printf 'header = "Authorization: Bearer %s"\n' "$auth"
    printf 'header = "Accept: application/vnd.github+json"\n'
    printf 'header = "X-GitHub-Api-Version: 2022-11-28"\n'
    printf 'url = "%s%s"\n' "$GITHUB_API" "$path"
    printf 'request = "%s"\n' "$method"
    if [ -n "$body" ]; then printf 'data = "%s"\n' "${body//\"/\\\"}"; fi
  } | curl -sS --fail-with-body -K -
}

mint_token() {
  local pem now header payload unsigned sig jwt inst
  pem="$(security find-generic-password -s "$BOT_KEYCHAIN_SERVICE" -w 2>/dev/null | base64 -d 2>/dev/null)" \
    || die "Keychain item $BOT_KEYCHAIN_SERVICE not readable - run new-bot-app.sh"
  [ -n "$pem" ] || die "Keychain item $BOT_KEYCHAIN_SERVICE is empty"
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  # iat 60 s in the past for clock drift; exp under GitHub's 10-minute cap.
  payload="$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$BOT_APP_ID" | b64url)"
  unsigned="$header.$payload"
  sig="$(printf '%s' "$unsigned" | openssl dgst -sha256 -binary -sign <(printf '%s\n' "$pem") | b64url)" \
    || die "could not sign the App JWT"
  unset pem
  jwt="$unsigned.$sig"
  inst="$(api GET "/repos/$BOT_REPO/installation" "$jwt" | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["id"])')" \
    || die "the App is not installed on $BOT_REPO - open https://github.com/apps/$BOT_SLUG/installations/new"
  # Scope the token to this one repository, even if the App is installed wider.
  api POST "/app/installations/$inst/access_tokens" "$jwt" \
      "{\"repositories\":[\"${BOT_REPO#*/}\"]}" \
    | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["token"])' \
    || die "could not get an installation token"
}

cmd="${1:-}"; [ -n "$cmd" ] || die "usage: bot-gh whoami | gh <args> | git <args> | push <branch>"
shift

case "$cmd" in
  whoami)
    echo "App: $BOT_SLUG (id $BOT_APP_ID)  bot login: $BOT_LOGIN  repo: $BOT_REPO"
    echo "Commit author: $BOT_LOGIN <$BOT_EMAIL>"
    ;;
  gh)
    BOT_TOKEN="$(mint_token)"
    GH_TOKEN="$BOT_TOKEN" GH_HOST=github.com exec gh "$@"
    ;;
  git|push)
    BOT_TOKEN="$(mint_token)"
    export BOT_TOKEN
    export GIT_AUTHOR_NAME="$BOT_LOGIN" GIT_AUTHOR_EMAIL="$BOT_EMAIL"
    export GIT_COMMITTER_NAME="$BOT_LOGIN" GIT_COMMITTER_EMAIL="$BOT_EMAIL"
    # The helper reads the token from the environment at call time, so the
    # token is not in git's argv or config. The empty helper first clears the
    # owner's own helpers (osxkeychain) for this one command.
    # It answers only a "get" for protocol=https and host=github.com (git
    # sends those lines on stdin, then a blank line). Any other host or
    # protocol gets no answer, so a third-party remote never receives the
    # token (git then fails or prompts; GIT_TERMINAL_PROMPT=0 stops prompts).
    # shellcheck disable=SC2016  # \$BOT_TOKEN must expand inside git, not here
    helper='!f() { [ "$1" = get ] || return 0; p=; h=; while IFS= read -r l; do [ -n "$l" ] || break; case "$l" in protocol=*) p="${l#protocol=}";; host=*) h="${l#host=}";; esac; done; [ "$p" = https ] && [ "$h" = github.com ] || return 0; echo username=x-access-token; echo "password=$BOT_TOKEN"; }; f'
    # SSH never: an SSH remote ignores credential.helper and signs in with
    # the owner's SSH key or agent, so the push would be the owner's, not the
    # bot's. protocol.ssh.allow=never makes git refuse the ssh transport
    # (also an https URL that the owner's url.*.pushInsteadOf rewrites to
    # ssh). GIT_SSH_COMMAND is a second stop if a git build ignores it;
    # GIT_ALLOW_PROTOCOL would override the -c setting, so it is cleared.
    # Use an HTTPS remote, or the `push` shortcut.
    unset GIT_ALLOW_PROTOCOL GIT_SSH
    export GIT_SSH_COMMAND='sh -c "echo bot-gh: SSH remotes are refused, use https://github.com/... >&2; exit 1"'
    export GIT_TERMINAL_PROMPT=0
    gitc=(-c credential.helper= -c "credential.helper=$helper"
          -c protocol.ssh.allow=never -c protocol.ext.allow=never
          -c core.sshCommand="$GIT_SSH_COMMAND")
    if [ "$cmd" = push ]; then
      branch="${1:-}"; [ -n "$branch" ] || die "usage: bot-gh push <branch>"
      exec git "${gitc[@]}" push "https://github.com/$BOT_REPO.git" "HEAD:refs/heads/$branch"
    fi
    exec git "${gitc[@]}" "$@"
    ;;
  *) die "unknown command '$cmd' (whoami | gh | git | push)" ;;
esac
