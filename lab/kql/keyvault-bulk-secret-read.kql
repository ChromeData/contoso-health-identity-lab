// =============================================================================
// Detection: Bulk secret reads from Key Vault (credential harvesting)
// Lab:       Contoso Health Identity Platform  (lab/ - ITDR pack, third set)
// SPL twin:  lab/splunk/detections/keyvault-bulk-secret-read.spl
// Ported:    from the owner's older Sentinel-Privileged-Access repo
//            (2026-11-06), rewritten for this lab (see "WHAT CHANGED").
// -----------------------------------------------------------------------------
// WHAT IT CATCHES
//   One caller reading secret VALUES from the lab's Key Vault far above its
//   own normal rate: the cloud version of someone emptying a CyberArk safe
//   in one go. Two signals per caller in the last hour:
//     BulkRead    : successful reads (HTTP 200) above
//                   max(ReadFloor, BaselineMultiplier x its own hourly mean
//                   over the 14 days before this hour).
//     DeniedBurst : DeniedFloor or more refused reads (HTTP 403). The vault's
//                   managed identity may read ONLY its own secret (the ABAC
//                   condition in modules/keyvault), so a burst of refusals is
//                   that identity, or a stolen token for it, trying secrets
//                   it was never given. The control held; someone still tried.
//   One row per caller.
//
// THE CALLER IS USUALLY NOT A PERSON
//   Most Key Vault traffic here comes from managed identities and apps, which
//   have no UPN. The rule therefore keys each caller on its OBJECT ID
//   (identity_claim_oid_g), then its app id, then its UPN, so a managed
//   identity is judged like a user. Keying on the UPN alone (the old rule)
//   put every managed identity into one empty-name bucket, and one busy app
//   could hide another.
//
// SEVERITY (dynamic - the Severity column)
//   High   : BulkRead across ManySecrets or more distinct secrets
//            (harvesting), or DeniedBurst across ManySecrets or more.
//   Medium : the same signals on fewer secrets (usually one app stuck in a
//            retry loop on its own secret; still worth a look).
//
// TABLE / SOURCE
//   AzureDiagnostics, Key Vault AuditEvent rows (modules/keyvault
//   diag-<vault>, category group "audit", no dedicated-table setting, so the
//   rows land in AzureDiagnostics). Columns read live with getschema on
//   loga-idlab on 2026-11-06: OperationName "SecretGet", httpStatusCode_d
//   (real), identity_claim_oid_g / _appid_g / _upn_s / _idtyp_s ("app" or
//   "user"), id_s (the secret's URL, name after /secrets/), Resource,
//   ResourceId, CallerIPAddress. A SecretGet for a missing secret is logged
//   with ResultType "Success" and HTTP 404, so the rule counts HTTP status
//   codes, not ResultType.
//   SecretList is NOT counted: listing names is not reading values, and a
//   backup job lists the vault every day.
//
// LICENSE
//   Key Vault diagnostic logs: no Entra licence; Log Analytics ingestion
//   cost only. Sentinel only: the 14-day baseline is longer than a Log
//   Analytics alert may look back (2 days).
//
// MITRE ATT&CK
//   T1555.006 Credentials from Password Stores: Cloud Secrets Management
//   Stores (CredentialAccess)
//   T1552.001 Unsecured Credentials: Credentials In Files (CredentialAccess)
//
// FALSE-POSITIVE NOTES
//   - A new app's first hour (no baseline, so the floor of ReadFloor reads
//     applies). Its baseline builds up over the following days.
//   - A rotation or migration job that reads every secret once. Expected
//     High: confirm the change ticket, then close.
//   - The operator reading secrets by hand during a lab session counts like
//     any other caller.
//
// TUNABLE
//   LookBack 14d, JudgeWindow 1h, ReadFloor 20, BaselineMultiplier 5,
//   DeniedFloor 20, ManySecrets 5.
//
// SUGGESTED SENTINEL RULE
//   Frequency 1h · Lookback 14d · one alert per row · Severity column ·
//   Entities: Account = CallerUpn / CallerObjectId, Azure resource =
//   VaultResourceId, IP = CallerIp.
//
// AUTOMATED RESPONSE
//   Notify only, never containment: the caller is usually a managed
//   identity or an app, which the containment playbook cannot disable
//   (it acts on Entra users). The responder removes or narrows the caller's
//   Key Vault role assignment and rotates every secret in SecretNames.
//
// WHAT CHANGED FROM THE OLD RULE
//   - Tactic spelled "CredentialAccess", Sentinel's name for it (the old
//     file said "Credentialaccess").
//   - Caller keyed on object id / app id, not UPN only (above).
//   - Only HTTP 200 counts as a read; 403s are their own signal; 404s and
//     SecretList never count.
//   - Severity by number of distinct secrets.
// =============================================================================

let LookBack = 14d;
let JudgeWindow = 1h;
let ReadFloor = 20;
let BaselineMultiplier = 5.0;
let DeniedFloor = 20;
let ManySecrets = 5;
let SecretGets = AzureDiagnostics
    | where TimeGenerated > ago(LookBack)
    | where ResourceProvider == "MICROSOFT.KEYVAULT" and Category == "AuditEvent"
    | where OperationName == "SecretGet"
    | extend CallerId = coalesce(identity_claim_oid_g, identity_claim_appid_g, tolower(identity_claim_upn_s), "(unknown)")
    | extend Status = toint(httpStatusCode_d)
    | extend SecretName = extract(@"/secrets/([^/?]+)", 1, id_s);
let Baseline = SecretGets
    | where TimeGenerated <= ago(JudgeWindow) and Status == 200
    | summarize BaselineReads = count() by CallerId
    | extend HourlyMean = todouble(BaselineReads) / ((LookBack - JudgeWindow) / 1h);
SecretGets
| where TimeGenerated > ago(JudgeWindow)
| summarize TimeGenerated = max(TimeGenerated),
            Reads = countif(Status == 200), Denied = countif(Status == 403),
            Secrets = dcountif(SecretName, Status == 200), DeniedSecrets = dcountif(SecretName, Status == 403),
            SecretNames = make_set_if(SecretName, Status == 200 or Status == 403, 20),
            Vaults = dcount(Resource), VaultResourceId = take_any(ResourceId),
            CallerObjectId = take_anyif(identity_claim_oid_g, isnotempty(identity_claim_oid_g)),
            CallerAppId = take_anyif(identity_claim_appid_g, isnotempty(identity_claim_appid_g)),
            CallerUpn = take_anyif(identity_claim_upn_s, isnotempty(identity_claim_upn_s)),
            CallerType = take_anyif(identity_claim_idtyp_s, isnotempty(identity_claim_idtyp_s)),
            CallerIp = take_anyif(CallerIPAddress, isnotempty(CallerIPAddress))
            by CallerId
| join kind=leftouter Baseline on CallerId
| project-away CallerId1
| extend HourlyMean = coalesce(HourlyMean, 0.0), BaselineReads = coalesce(BaselineReads, 0)
| extend ReadThreshold = max_of(todouble(ReadFloor), HourlyMean * BaselineMultiplier)
| extend BulkRead = todouble(Reads) > ReadThreshold, DeniedBurst = Denied >= DeniedFloor
| where BulkRead or DeniedBurst
| extend Signal = case(BulkRead and DeniedBurst, "bulk read + denied burst", BulkRead, "bulk read", "denied burst")
| extend Severity = iff((BulkRead and Secrets >= ManySecrets) or (DeniedBurst and DeniedSecrets >= ManySecrets), "High", "Medium")
| project TimeGenerated, Severity, Signal, CallerId, CallerType, CallerUpn, CallerObjectId, CallerAppId, CallerIp,
          Reads, Secrets, Denied, DeniedSecrets, SecretNames, Vaults, VaultResourceId,
          BaselineReads, HourlyMean, ReadThreshold
