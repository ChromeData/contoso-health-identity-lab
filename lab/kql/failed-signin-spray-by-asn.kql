// =============================================================================
// Detection: Password spray across many IPs of one network (distinct users per ASN)
// Lab:       Contoso Health Identity Platform  (lab/ - ITDR pack, fourth set)
// SPL twin:  lab/splunk/detections/failed-signin-spray-by-asn.spl
// -----------------------------------------------------------------------------
// WHAT IT CATCHES
//   A slow or distributed password spray: credential failures against 10 or
//   more DISTINCT users within one hour from one autonomous system (ASN),
//   with few tries per user. A spray from a botnet or a cloud provider's
//   addresses stays under failed-signin-spike's 10-per-IP threshold on every
//   single IP, but not per network (review finding D1, 2026-11-07).
//
// TABLE / SOURCE
//   SigninLogs and AADNonInteractiveUserSignInLogs (both carry
//   AutonomousSystemNumber, Microsoft Learn column lists). The non-interactive
//   table matters: a spray against legacy or token endpoints may never show
//   in SigninLogs.
//
// LICENSE
//   Entra ID P1 for the sign-in log export.
//
// MITRE ATT&CK
//   T1110.003 Brute Force: Password Spraying.
//
// FALSE-POSITIVE NOTES
//   - The hospital's own ASN (all staff behind one ISP): exclude it with
//     TrustedAsns (rendered by modules/monitoring from var.trusted_asns).
//   - A broken app with a stale password across many service accounts: the
//     Users list shows it at once.
//
// SEVERITY (the Severity column)
//   High   : a user in the set ALSO signed in successfully from the same ASN
//            AFTER their first sprayed failure (the spray may have worked).
//            A success earlier in the hour does not count.
//   Medium : failures only.
//
// AUTOMATED RESPONSE
//   Notify playbook. No containment (no single account).
// =============================================================================

let LookBack = 1h;
let MinDistinctUsers = 10;
let MaxTriesPerUser = 3;     // a spray tries each user a few times only
let CredentialFailureCodes = dynamic(["50126", "50053", "50055", "50056", "50057", "50034"]);
let TrustedAsns = dynamic([]); // @@TRUSTED_ASNS@@
let SignIns = union
    (SigninLogs | where TimeGenerated > ago(LookBack)
        | project TimeGenerated, UserPrincipalName, IPAddress, ResultType, Asn = tostring(AutonomousSystemNumber)),
    (AADNonInteractiveUserSignInLogs | where TimeGenerated > ago(LookBack)
        | project TimeGenerated, UserPrincipalName, IPAddress, ResultType, Asn = tostring(AutonomousSystemNumber))
| where isnotempty(Asn) and not(Asn in (TrustedAsns));
// Per ASN and user first, so the success check is exact: the lists are
// capped for display only AFTER each user is judged (review of #233).
let PerUser = SignIns
| summarize Tries = countif(ResultType in (CredentialFailureCodes)),
            FirstFail = minif(TimeGenerated, ResultType in (CredentialFailureCodes)),
            LastOk = maxif(TimeGenerated, ResultType == "0"),
            Ips = make_set_if(IPAddress, ResultType in (CredentialFailureCodes), 20)
    by Asn, UserPrincipalName
// A hit is a success AFTER the user's first sprayed failure: a normal
// sign-in earlier in the hour is not a compromise (review of #233).
| extend Hit = isnotnull(FirstFail) and isnotnull(LastOk) and LastOk > FirstFail;
PerUser
| where Tries between (1 .. MaxTriesPerUser)
| summarize DistinctUsers = dcount(UserPrincipalName), Users = make_set(UserPrincipalName, 50),
            FailedCount = sum(Tries), CompromisedCount = countif(Hit),
            Compromised = make_set_if(UserPrincipalName, Hit, 50), Ips = make_set(Ips, 50)
    by Asn
| where DistinctUsers >= MinDistinctUsers
| extend Severity = iff(CompromisedCount > 0, "High", "Medium")
| extend TimeGenerated = now()
| project TimeGenerated, Severity, Asn, DistinctUsers, FailedCount, CompromisedCount, Users, Compromised, Ips
| sort by DistinctUsers desc
