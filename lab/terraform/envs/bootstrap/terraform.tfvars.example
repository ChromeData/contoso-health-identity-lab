# =============================================================================
# envs/bootstrap :: terraform.tfvars.example
# -----------------------------------------------------------------------------
# Copy to terraform.tfvars (gitignored) and fill in. Applied locally only.
# =============================================================================

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "11111111-1111-1111-1111-111111111111"

# The PUBLIC lab repo. The OIDC subjects are built from these - a typo here
# means every pipeline login fails with AADSTS70021 (no matching federated
# identity record).
github_owner          = "your-github-user"
github_repo           = "contoso-health-identity-lab"
# Immutable numeric ids, readable only after the public repo exists:
#   gh api repos/OWNER/REPO --jq '.owner.id, .id'
# GitHub.com repos created after 2026-07-15 emit
# repo:OWNER@OWNER-ID/REPO@REPO-ID subjects; a wrong id also means AADSTS70021.
github_owner_id       = "<numeric>"
github_repo_id        = "<numeric>"
prod_environment_name = "prod"

tfstate_resource_group_name  = "rg-identity-lab-tfstate"
tfstate_storage_account_name = "stidlabtfstate7f3a"
tfstate_container_name       = "tfstate"

# Set after creating the Azure OpenAI account, then re-apply.
azure_openai_resource_id = ""

# Second bootstrap run, after envs/dev created the workspace (needs P1/P2):
#   terraform -chdir=../dev output -raw log_analytics_workspace_id
log_analytics_workspace_id = ""

# Opt-in widenings - each a deliberate human apply (see variables.tf):
#   enable_app_management_roles: before envs/dev enable_sso_apps (Tier-0 role
#     AppRoleAssignment.ReadWrite.All - record it in the risk register).
#   enable_identity_protection_logs: once the E5 (P2) licences are assigned,
#     before envs/dev enable_itdr_detections' identity_risk rule.
enable_app_management_roles     = false
enable_identity_protection_logs = false

# HR-SYNC (.github/workflows/hr-feed.yml). Protect the hr-feed branch first.
# The client id is the last segment of the HR provisioning job id
# (API2AD.<tenant>.<client id>). After the apply: run the printed
# hr_sync_service_principal_owner_command once, grant admin consent if the
# portal asks, and set the HR_SYNC_CLIENT_ID repo variable.
enable_hr_sync                = false
hr_provisioning_app_client_id = ""
hr_sync_upload_scope          = "owned"

# EVIDENCE (.github/workflows/evidence-pack.yml, main only): read-only Graph
# for the evidence pack + create-only access to the WORM evidence container.
# The account name is envs/dev's evidence_storage_account_name output. After
# the apply: set the EVIDENCE_CLIENT_ID repo variable
# (terraform output -raw github_oidc_evidence_client_id).
enable_evidence_pack          = false
evidence_storage_account_name = "stidlabevidence7f3a"
evidence_resource_group_name  = "rg-identity-lab"

# PIM-Demo-Readers' Azure half (read-only presenter): Reader, Microsoft
# Sentinel Reader and Log Analytics Reader on this subscription, for a group
# whose members are eligible-only. After the envs/dev apply that creates it:
#   terraform -chdir=../dev output -raw pim_demo_readers_group_object_id
enable_pim_demo_readers_azure_rbac = false
pim_demo_readers_group_object_id   = ""

# Human owners of the HR provisioning app's registration (ADR 0018, two
# people from the adm- admin accounts; never the access governance lead,
# SOD-08). The CI identities (PLAN, APPLY, HR-SYNC, EVIDENCE) never get an
# Entra owner: their accountable owner is a role in lab/iga/nhi-owners.json.
# hr_provisioning_owner_object_ids = ["33333333-3333-3333-3333-333333333333", "44444444-4444-4444-4444-444444444444"]
