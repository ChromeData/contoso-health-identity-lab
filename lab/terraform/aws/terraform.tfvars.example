# =============================================================================
# aws :: terraform.tfvars.example
# -----------------------------------------------------------------------------
# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (see
# lab/terraform/.gitignore). All values below are placeholders.
#
# There are NO credentials in this file and there never should be: the
# provider authenticates from your AWS CLI profile (`aws sso login`).
# =============================================================================

# ---- Provider / authentication ----------------------------------------------
# Created once with:  aws configure sso --profile idlab-admin
# Refreshed with:     aws sso login --profile idlab-admin
aws_profile = "idlab-admin"

# The region your IAM Identity Center instance lives in
# (Identity Center console -> Settings -> Details -> Region).
aws_region = "us-east-1"

# Wrong-profile guard: the account that holds the Identity Center instance.
allowed_account_ids = ["123456789012"]

# ---- What gets granted -------------------------------------------------------
# Empty = the account the profile signs into (single-account lab) - i.e. the
# Organizations MANAGEMENT account. Fine for this view-only lab grant; in a
# real org put a MEMBER account id here (README: "The target is the
# management account").
target_account_id = ""

# Contract name from modules/groups - leave as is unless you renamed it.
group_display_name = "App-AWS-IdentityCenter-Users"

# OPTIONAL lineage pin - the Entra object id of App-AWS-IdentityCenter-Users:
#   terraform -chdir=../envs/dev output -json app_access_group_object_ids | jq -r .aws
# Set it only after `aws identitystore describe-group` shows that id under
# ExternalIds (see README, step 4).
entra_group_object_id = ""

# Matches the 4-hour PIM activation window on the Entra side. PT1H..PT12H.
session_duration = "PT4H"

# ---- Tags -------------------------------------------------------------------
tags = {
  project     = "contoso-health-identity-lab"
  environment = "dev"
  managed_by  = "terraform"
  source_idp  = "entra-id"
  owner       = "iam-platform-team"
}

# ---- GitHub Actions OIDC (optional, off by default - github-oidc.tf) --------
# A READ-ONLY role a workflow of this repo can assume with no AWS key.
# Same owner/repo ids as envs/bootstrap: gh api repos/OWNER/REPO --jq '.owner.id, .id'
enable_github_oidc           = false
github_owner                 = "your-github-user"
github_owner_id              = "1234567"
github_repo                  = "contoso-health-identity-lab"
github_repo_id               = "7654321"
github_oidc_subject_suffixes = ["pull_request"]
# Reuse an account's existing GitHub OIDC provider instead of creating one:
existing_github_oidc_provider_arn = ""

# ---- Lab operator (optional, off by default - entra-operator.tf) ------------
# AWS trusts the Entra lab operator (lab/terraform/envs/operator outputs).
enable_entra_operator    = false
entra_tenant_id          = "00000000-0000-0000-0000-000000000000"
entra_operator_client_id = "00000000-0000-0000-0000-000000000000"
entra_operator_object_id = "00000000-0000-0000-0000-000000000000"

# ---- AWS admin without root (optional, off by default - lab-admin.tf) -------
# LabAdministrator (AdministratorAccess, 1 h) for the SCIM copy of the Entra
# PIM group PIM-AWS-Lab-Admins (ADR 0025). Needs envs/dev enable_pim_aws_admin.
enable_lab_admin_jit         = false
lab_admin_group_display_name = "PIM-AWS-Lab-Admins"
# Optional lineage pin: envs/dev output aws_admin_group_object_id
lab_admin_entra_group_object_id = ""
lab_admin_session_duration      = "PT1H"

# ---- Audit trail (optional, off by default - audit-trail.tf) ----------------
# CloudTrail trail contoso-lab-audit-trail + its S3 bucket + the free
# external-access IAM Access Analyzer. Apply with the LabAdministrator
# profile (idlab-labadmin): the analyzer's service-linked role needs an IAM
# write the operator is denied.
enable_audit_baseline    = false
audit_log_retention_days = 365

# ---- Session Manager server path (optional, off by default - session-manager.tf)
# One t4g.micro with NO inbound port, NO SSH key and NO public IP, reachable
# only by a Session Manager shell; four interface endpoints (~$1/day); session
# transcripts in CloudWatch Logs; the LabServerSession permission set for the
# SCIM copy of PIM-AWS-Lab-Admins. Apply with idlab-labadmin. Turn it off
# again after a capture (destroys the server and the endpoints).
enable_session_manager        = false
session_node_running          = true
session_node_instance_type    = "t4g.micro"
session_group_display_name    = "PIM-AWS-Lab-Admins"
session_group_entra_object_id = "" # envs/dev output aws_admin_group_object_id
session_target_tag_key        = "session-access"
session_target_tag_value      = "lab-server-session"
session_log_retention_days    = 30
