# =============================================================================
# okta :: terraform.tfvars.example
# -----------------------------------------------------------------------------
# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (see
# lab/terraform/.gitignore). All values below are placeholders.
#
# There are NO credentials in this file and there never should be:
#   * the Okta API token is OKTA_API_TOKEN in your shell (providers.tf);
#   * the Entra client secret is TF_VAR_entra_client_secret, exported for
#     the one apply that turns enable_entra_federation on (README).
# =============================================================================

# ---- The org -----------------------------------------------------------------
# Integrator Free orgs are integrator-NNNNNNN.okta.com: the subdomain here,
# the cell below. Output okta_org_domain joins them; envs/dev's
# okta_org_domain must be the same string.
okta_org_name = "integrator-1234567"
okta_base_url = "okta.com"

# ---- The clinic's estate (always planned) -------------------------------------
# The clinic users' login domain: routed to Entra, and the Clinic-Staff rule.
clinic_login_domain = "clinic.contoso.example"

clinic_staff_group_name = "Clinic-Staff"
legacy_app_label        = "Clinic Scheduling (legacy)"
legacy_app_url          = "https://scheduling.clinic.example/" # placeholder: no scheduling system exists

# ---- Federation (second apply, after the Entra app exists) --------------------
# Values from `terraform -chdir=../envs/dev output`:
#   okta_idp_client_id  -> entra_client_id
#   okta_idp_endpoints  -> the tenant id in every URL -> entra_tenant_id
# The secret: run output okta_idp_client_secret_command as a human, then
#   read -s TF_VAR_entra_client_secret && export TF_VAR_entra_client_secret
enable_entra_federation = false
entra_tenant_id         = "" # 11111111-1111-1111-1111-111111111111
entra_client_id         = "" # the okta-clinic-idp client id
entra_idp_name          = "Microsoft Entra ID (Contoso Health)"
jit_provisioning        = true # [prod] false: pre-linked accounts only

# THE ROLLBACK: false = routing rule INACTIVE, clinic users back on Okta
# passwords at the next sign-in. A check warns on every plan while false.
routing_rule_active = true
routing_rule_name   = "Clinic staff to Microsoft Entra ID"
