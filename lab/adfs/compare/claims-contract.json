    "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname": "exact",
    "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname": "exact",
    "urn:contoso:claims:department": "exact",
    "urn:contoso:claims:employeeid": "exact",
    "http://schemas.microsoft.com/ws/2008/06/identity/claims/role": "exact",
    "urn:contoso:claims:shortname": "casefold"
  },
  "platform": [
    "http://schemas.microsoft.com/identity/claims/tenantid",
    "http://schemas.microsoft.com/identity/claims/objectidentifier",
    "http://schemas.microsoft.com/identity/claims/identityprovider",
    "http://schemas.microsoft.com/identity/claims/displayname",
    "http://schemas.microsoft.com/claims/authnmethodsreferences",
