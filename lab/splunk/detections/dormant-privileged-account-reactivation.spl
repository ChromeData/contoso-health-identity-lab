index=entra ((sourcetype="azure:loganalytics:signinlogs" ResultType="0") OR (sourcetype="azure:loganalytics:aadnoninteractiveusersigninlogs" ResultType="0") OR (sourcetype="azure:loganalytics:auditlogs" OperationName="Add user")) earliest=-14d latest=now
``` ========================================================================== ```
``` Detection (SPL): Dormant privileged account signs in again                ```
``` Lab:             Contoso Health Identity Platform - Splunk second SIEM     ```
``` KQL twin:        lab/kql/dormant-privileged-account-reactivation.kql      ```
```                  (same logic, window and output columns)                  ```
``` -------------------------------------------------------------------------- ```
``` STAND-IN: Splunk Enterprise 60-day TRIAL over Entra logs fed from Log      ```
``` Analytics by lab/scripts/monitoring/feed-splunk-live.py.                   ```
```                                                                            ```
``` WHAT IT CATCHES                                                             ```
```   A privileged account with no successful sign-in (interactive or         ```
```   non-interactive) in the 14 days before this hour signs in               ```
```   interactively in the last hour. Privileged = object id in the           ```
```   contoso_privileged_identities.csv lookup, or the admin naming adm-name  ```
```   or tier0-admin-NN. bg-admin-NN is left to break-glass-signin.           ```
```   Severity column: High; Medium when an Add user event for the account   ```
```   is inside the 14 days (a new admin first sign-in).                      ```
``` MITRE ATT&CK: T1078.004 Valid Accounts: Cloud Accounts.                   ```
```                                                                            ```
``` KQL -> SPL TRANSLATION                                                      ```
```   Successes / PriorActivity / CreatedInWindow lets -> one search over the  ```
```                                               three sourcetypes, one stats ```
```                                               BY the user object id        ```
```   join kind=leftanti PriorActivity           -> PriorSignIns == 0          ```
```   arg_min(TimeGenerated, IP, App)            -> min() over a packed string ```
```                                               that starts with the epoch   ```
```   mv-expand TargetResources (Add user)       -> spath + mvexpand UserKey   ```
```   UserId in (PrivilegedUserIds)              -> lookup contoso_privileged_ ```
```                                               identities.csv (object_id)   ```
``` HONEST DIFFERENCE: values() is uncapped where KQL make_set caps the IP set ```
``` at 10, so the twin keeps the first 10 only (mvindex).                     ```
```                                                                            ```
``` SCHEDULE: PT1H / P14D, base severity High, throttled 1 h per user.         ```
``` ========================================================================== ```
``` @stanza Contoso - Dormant privileged account signs in again ```
``` @conf description = A privileged account with no successful sign-in for 14 days signed in interactively in the last hour. Medium when the account was created inside those 14 days. KQL twin: lab/kql/dormant-privileged-account-reactivation.kql ```
``` @conf disabled = 0 ```
``` @conf enableSched = 1 ```
``` @conf cron_schedule = 11 * * * * ```
``` @conf dispatch.earliest_time = -14d ```
``` @conf dispatch.latest_time = now ```
``` @conf counttype = number of events ```
``` @conf relation = greater than ```
``` @conf quantity = 0 ```
``` @conf alert.track = 1 ```
``` @conf alert.severity = 5 ```
``` @conf alert.expires = 7d ```
``` @conf alert.digest_mode = 0 ```
``` @conf alert.suppress = 1 ```
``` @conf alert.suppress.fields = UserId,Severity ```
``` @conf alert.suppress.period = 1h ```
``` @conf request.ui_dispatch_app = search ```
``` @conf request.ui_dispatch_view = search ```
| eval Kind=case(sourcetype=="azure:loganalytics:auditlogs", "created", sourcetype=="azure:loganalytics:signinlogs", "interactive", true(), "non-interactive")
| where Kind!="created" OR lower(Result)=="success"
| spath path=TargetResources{}.id output=TargetIds
| eval UserKey=if(Kind=="created", TargetIds, UserId)
| mvexpand UserKey
| where isnotnull(UserKey) AND UserKey!=""
| eval Upn=if(Kind=="created", null(), lower(UserPrincipalName))
| eval InJudge=if(_time>=relative_time(now(), "-1h"), 1, 0)
| eval Prior=if(Kind!="created" AND InJudge==0, 1, 0)
| eval Wake=if(Kind=="interactive" AND InJudge==1, 1, 0)
| eval WakePack=if(Wake==1, tostring(round(_time, 3)) . "|" . coalesce(IPAddress, "") . "|" . coalesce(AppDisplayName, ""), null())
| eval WakeIp=if(Wake==1, IPAddress, null())
| eval CreatedTime=if(Kind=="created", _time, null())
| stats sum(Prior) AS PriorSignIns, sum(Wake) AS SignIns, min(WakePack) AS FirstWake, values(WakeIp) AS IPAddresses, min(CreatedTime) AS CreatedEpoch, values(Upn) AS Upns BY UserKey
| where SignIns > 0 AND PriorSignIns == 0
| eval UserPrincipalName=mvindex(Upns, 0)
| lookup contoso_privileged_identities.csv object_id AS UserKey OUTPUT object_id AS PrivIdHit
| eval PrivilegedById=if(isnotnull(PrivIdHit), "true", "false")
| eval PrivilegedByName=if(match(coalesce(UserPrincipalName, ""), "(?i)^(adm-[a-z0-9._-]+|tier0-admin-[0-9]{2})@"), "true", "false")
| where (PrivilegedById=="true" OR PrivilegedByName=="true") AND NOT match(coalesce(UserPrincipalName, ""), "(?i)^bg-admin-[0-9]{2}@")
| eval WakeParts=split(FirstWake, "|")
| eval WakeEpoch=tonumber(mvindex(WakeParts, 0)), IPAddress=mvindex(WakeParts, 1), AppDisplayName=mvindex(WakeParts, 2)
| eval NewAccount=if(isnotnull(CreatedEpoch), "true", "false")
| eval Severity=if(NewAccount=="true", "Medium", "High")
| eval IPAddresses=mvindex(IPAddresses, 0, 9)
| eval UserId=UserKey
| eval TimeGenerated=strftime(WakeEpoch, "%Y-%m-%dT%H:%M:%S.%3N%z"), CreatedOn=strftime(CreatedEpoch, "%Y-%m-%dT%H:%M:%S.%3N%z"), QuietSince=strftime(relative_time(now(), "-14d"), "%Y-%m-%dT%H:%M:%S.%3N%z")
| sort 0 - WakeEpoch
| table TimeGenerated, Severity, UserPrincipalName, UserId, PrivilegedById, NewAccount, CreatedOn, QuietSince, SignIns, IPAddress, IPAddresses, AppDisplayName
