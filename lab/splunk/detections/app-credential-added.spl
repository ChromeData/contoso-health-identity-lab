index=entra sourcetype="azure:loganalytics:auditlogs" Category="ApplicationManagement" earliest=-1h latest=now
``` ========================================================================== ```
``` Detection (SPL): Credential added to an application or service principal  ```
``` Lab:             Contoso Health Identity Platform - Splunk second SIEM     ```
``` KQL twin:        lab/kql/app-credential-added.kql (same logic/window)      ```
``` -------------------------------------------------------------------------- ```
``` STAND-IN: Splunk Enterprise 60-day TRIAL over Entra AuditLogs REPLAYED     ```
``` from Log Analytics by lab/splunk/ingest-from-loganalytics.sh. Base search  ```
``` is line 1 on purpose: a comment before the first command breaks a search. ```
```                                                                            ```
``` WHAT IT CATCHES                                                             ```
```   A NEW secret, certificate or federated identity credential on an app     ```
```   registration or service principal (persistence on a workload identity). ```
```   Removals and unchanged lists return nothing. Severity column: High for   ```
```   a credential on the service principal object or a new FIC, Medium for an ```
```   app secret/cert, Low when the CI apply identity made the change.         ```
``` MITRE ATT&CK: T1098.001 Additional Cloud Credentials (Persistence).        ```
```                                                                            ```
``` KQL -> SPL TRANSLATION                                                      ```
```   OperationName has_any (...)        -> match() with (?i) alternation       ```
```   tostring(TargetResources) has FIC  -> like(_raw, %FederatedIdentity...%)  ```
```   mv-apply tr ... where type in~     -> spath TargetResources{} + mvfilter  ```
```   mv-apply mp ... KeyDescription     -> spath modifiedProperties{} + mvfilter ```
```   set_has_element(OldStrings, n)     -> per-element mvexpand, then the      ```
```                                          element KEY (KeyIdentifier GUID,   ```
```                                          or the FIC Subject) must not occur ```
```                                          in the old JSON text, then stats   ```
```                                          back to one row per audit event    ```
```   HONEST DIFFERENCE: KQL diffs whole elements, SPL diffs element keys. An  ```
```   FIC edited in place (same Subject, new Issuer) is Added in KQL only.     ```
```   verify: json_array_to_mv returns string elements without their JSON     ```
```   quotes (Splunk 8.1+ JSON eval functions).                                ```
```                                                                            ```
``` SCHEDULE: mirrors the Sentinel rule (lab/terraform/modules/monitoring):     ```
``` PT5M / PT1H, base severity Medium (Splunk alert severity is static; the    ```
``` Severity column carries the dynamic value), throttled 1 h per Actor +      ```
``` Severity.                                                                   ```
``` ========================================================================== ```
``` @stanza Contoso - Credential added to an application or service principal ```
``` @conf description = A new secret, certificate or federated identity credential on an app registration or service principal. KQL twin: lab/kql/app-credential-added.kql ```
``` @conf disabled = 0 ```
``` @conf enableSched = 1 ```
``` @conf cron_schedule = */5 * * * * ```
``` @conf dispatch.earliest_time = -1h ```
``` @conf dispatch.latest_time = now ```
``` @conf counttype = number of events ```
``` @conf relation = greater than ```
``` @conf quantity = 0 ```
``` @conf alert.track = 1 ```
``` @conf alert.severity = 4 ```
``` @conf alert.expires = 7d ```
``` @conf alert.digest_mode = 0 ```
``` @conf alert.suppress = 1 ```
``` @conf alert.suppress.fields = Actor,Severity ```
``` @conf alert.suppress.period = 1h ```
``` @conf request.ui_dispatch_app = search ```
``` @conf request.ui_dispatch_view = search ```
| where Category=="ApplicationManagement" AND lower(Result)=="success"
| where match(OperationName, "(?i)(Add service principal credentials|Certificates and secrets management)") OR (lower(OperationName)=="update application" AND like(_raw, "%FederatedIdentityCredentials%"))
| spath path=InitiatedBy.user.userPrincipalName output=ActorUpn
| spath path=InitiatedBy.user.id output=ActorObjectId
| spath path=InitiatedBy.app.displayName output=ActorApp
| spath path=InitiatedBy.app.servicePrincipalId output=ActorAppSpId
| spath path=InitiatedBy.app.appId output=ActorAppId
| spath path=InitiatedBy.user.ipAddress output=ActorUserIp
| spath path=InitiatedBy.app.ipAddress output=ActorAppIp
| eval ActorIp=if(isnotnull(ActorUserIp) AND ActorUserIp!="", ActorUserIp, ActorAppIp)
| eval Actor=if(isnotnull(ActorUpn) AND ActorUpn!="", ActorUpn, ActorApp)
| spath path=TargetResources{} output=TR
| eval TRMatch=mvfilter(match(spath(TR, "type"), "(?i)^(Application|ServicePrincipal)$"))
| eval TR1=mvindex(TRMatch, 0)
| eval TargetName=spath(TR1, "displayName"), TargetObjectId=spath(TR1, "id"), TargetType=spath(TR1, "type")
| eval MP=spath(TR1, "modifiedProperties{}")
| eval MPMatch=mvfilter(match(spath(MP, "displayName"), "(?i)^(KeyDescription|FederatedIdentityCredentials)$"))
| eval MP1=mvindex(MPMatch, 0)
| eval ChangedProperty=spath(MP1, "displayName"), OldValue=coalesce(spath(MP1, "oldValue"), ""), NewValue=spath(MP1, "newValue")
| where isnotnull(ChangedProperty) AND ChangedProperty!=""
| eval FirstCredential=if(OldValue=="" OR OldValue=="[]", "true", "false")
| eval EventKey=CorrelationId . "|" . _time . "|" . TargetObjectId
| eval NewItem=json_array_to_mv(NewValue)
| mvexpand NewItem
| rex field=NewItem "KeyIdentifier=(?<KeyId>[^,]+)"
| rex field=NewItem "KeyType=(?<KeyType>[^,]+)"
| eval FicIssuer=coalesce(spath(NewItem, "Issuer"), spath(NewItem, "issuer")), FicSubject=coalesce(spath(NewItem, "Subject"), spath(NewItem, "subject"))
| eval ItemKey=coalesce(KeyId, FicSubject, NewItem)
| where NOT like(OldValue, "%" . ItemKey . "%")
| stats count AS AddedCount, values(KeyType) AS KeyTypes, values(FicIssuer) AS FicIssuers, values(FicSubject) AS FicSubject, first(_time) AS _time, first(TimeGenerated) AS TimeGenerated, first(Actor) AS Actor, first(ActorUpn) AS ActorUpn, first(ActorObjectId) AS ActorObjectId, first(ActorApp) AS ActorApp, first(ActorAppSpId) AS ActorAppSpId, first(ActorAppId) AS ActorAppId, first(ActorIp) AS ActorIp, first(OperationName) AS OperationName, first(TargetType) AS TargetType, first(TargetName) AS TargetName, first(TargetObjectId) AS TargetObjectId, first(ChangedProperty) AS ChangedProperty, first(FirstCredential) AS FirstCredential, first(CorrelationId) AS CorrelationId BY EventKey
| eval CredentialKind=case(lower(ChangedProperty)=="federatedidentitycredentials", "FederatedIdentityCredential", isnotnull(mvfind(KeyTypes, "^Password$")), "ClientSecret", isnotnull(mvfind(KeyTypes, "^AsymmetricX509Cert$")), "Certificate", true(), "Other")
| lookup contoso_iac_principals.csv principal_id AS ActorAppSpId OUTPUT principal_id AS IacBySp
| lookup contoso_iac_principals.csv principal_id AS ActorAppId OUTPUT principal_id AS IacByApp
| eval IsIac=if(isnotnull(IacBySp) OR isnotnull(IacByApp), "true", "false")
| eval IacNameSpoof=if(IsIac=="false" AND lower(coalesce(ActorApp, ""))=="gh-oidc-entra-apply (write)", "true", "false")
| eval Severity=case(IacNameSpoof=="true", "High", IsIac=="true", "Low", lower(TargetType)=="serviceprincipal" OR CredentialKind=="FederatedIdentityCredential", "High", true(), "Medium")
| sort 0 - _time
| table TimeGenerated, Severity, Actor, ActorUpn, ActorObjectId, ActorApp, ActorAppSpId, ActorIp, IsIac, IacNameSpoof, OperationName, TargetType, TargetName, TargetObjectId, CredentialKind, KeyTypes, FicIssuers, FicSubject, AddedCount, FirstCredential, CorrelationId
