# =============================================================================
# lab/splunk/.env.example - every variable the Splunk second-SIEM stack reads.
# -----------------------------------------------------------------------------
# STAND-IN: Splunk Enterprise 60-day trial (local container) replaces
# production Splunk; see README.md.
#
# You do NOT copy this file. ./splunk-up.sh writes lab/splunk/.env (mode 0600,
# gitignored) with random values for the GENERATED block and leaves the
# LICENSE block empty for you. This file documents the keys only and must
# never hold real values.
# =============================================================================

# --- LICENSE ACCEPTANCE - the human's decision, never a script's -------------
# 1. Read the Splunk General Terms:
#      https://www.splunk.com/en_us/legal/splunk-general-terms.html
# 2. Only if you accept them, put EXACTLY these values in lab/splunk/.env:
#      SPLUNK_START_ARGS=--accept-license
#      SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
#    Both are required by the 10.x image; docker compose refuses to start
#    while either is empty, and splunk-up.sh refuses to continue.
SPLUNK_START_ARGS=
SPLUNK_GENERAL_TERMS=

# --- GENERATED by splunk-up.sh (random per laptop; never commit) --------------
# Splunk Web / REST admin password ("Sp-" + 32 hex + "-9a").
SPLUNK_PASSWORD=
# HTTP Event Collector token (GUID). splunk-up.sh pins it to index=entra.
SPLUNK_HEC_TOKEN=

# --- OPTIONAL overrides for ingest-from-loganalytics.sh -----------------------
# Contract names from lab/terraform/envs/dev (resource_group_name /
# log_analytics_name). LA_WORKSPACE_ID (the workspace *customer id* GUID)
# skips the `az monitor log-analytics workspace show` lookup when set.
LA_RESOURCE_GROUP=rg-identity-lab
LA_WORKSPACE_NAME=loga-idlab
LA_WORKSPACE_ID=
