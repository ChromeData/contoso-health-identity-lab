# Generated by ./pam-up.sh into .env (gitignored). Do not fill by hand.
GUAC_DB_PASSWORD=
MIDPOINT_DB_PASSWORD=
MIDPOINT_ADMIN_PASSWORD=
# Set by ./vault-onboard-ad.sh
DC_FQDN=
DC_PUBLIC_IP=
# Set by ./pam-up.sh (ticket validation for check-out). ITSM_URL points at the
# local ServiceNow Table API mock; at tenant time set it to the PDI
# (https://devNNNNN.service-now.com) and put that integration user's password
# in .secrets/itsm-password. ITSM_AUTH_SHA256 is for the mock only.
ITSM_URL=
ITSM_USER=
ITSM_AUTH_SHA256=
