# Generated by the PAM ops scripts. Reports name real (lab) accounts and
# operators; the ITSM mock's tickets are local data. (HA cluster keys and
# snapshots live in .secrets/ha/, ignored by the repo-root .gitignore.)
out/
itsm/data/

# Runtime secrets: the repo-root .gitignore already ignores lab/pam/.env and
# lab/pam/.secrets/ (Vault unseal key + root token, Guacamole / ITSM
# credentials, operator lab passwords, the test harnesses' Samba passwords in
# .secrets/test/ and .secrets/vault-anomaly/). Repeated here as a second line
# of defence, with the dynamic-db segment's own secrets folder (also ignored
# by dynamic-db/.gitignore).
.env
.secrets/
dynamic-db/.secrets/
