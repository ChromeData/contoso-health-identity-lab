# =============================================================================
# lab/pam/ha/vault-node.hcl - one node of the 3-node Vault HA cluster
# (docker-compose.ha.yml, ./vault-ha.sh). Shared by vault-1/2/3; what differs
# per node comes from the environment the Vault docs define for it:
#   VAULT_RAFT_NODE_ID  node_id        VAULT_API_ADDR      api_addr
#   VAULT_CLUSTER_ADDR  cluster_addr
# The seal stanza (transit auto-unseal, with its token) is generated by
# vault-ha.sh into .secrets/ha/seal.hcl and mounted next to this file.
#
# CyberArk mapping: integrated storage (Raft) replicates every write to a
# quorum, like a Primary Vault + DR Vault pair, but active/standby with
# automatic leader election instead of a manual DR failover.
# =============================================================================
ui = true

# HashiCorp's guidance for integrated storage: mlock interacts badly with
# BoltDB's memory-mapped files, so disable it and protect the host instead
# (encrypted swap / no swap). The single-node lab Vault keeps mlock on.
disable_mlock = true

storage "raft" {
  # /vault/file is chowned to the vault user by the image entrypoint.
  path = "/vault/file"

  # 1 = HashiCorp's production setting: fastest leader election (the
  # default 0 means 5x slower timers, meant for slow dev machines).
  performance_multiplier = 1

  # Every node knows every candidate leader; a node never joins itself.
  retry_join {
    leader_api_addr = "http://vault-1:8200"
  }
  retry_join {
    leader_api_addr = "http://vault-2:8200"
  }
  retry_join {
    leader_api_addr = "http://vault-3:8200"
  }
}

# Lab: plain HTTP on the private compose network, API ports published on
# 127.0.0.1 only. Raft's own cluster port (8201) is always mutual TLS with
# certificates Vault issues itself. Production: TLS on 8200 too, and the
# retry_join blocks carry leader_ca_cert.
listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable     = true
}
