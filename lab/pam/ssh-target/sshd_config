# sshd for the Vault SSH CA target: certificates only (see Dockerfile).
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key

# Who may log in: holders of a certificate signed by Vault's SSH CA whose
# principal is listed for the account. No authorized_keys files at all, so a
# key that leaked from an old session is worthless once its cert expires.
TrustedUserCAKeys /etc/ssh/trusted-user-ca-keys.pem
AuthorizedPrincipalsFile /etc/ssh/auth_principals/%u
AuthorizedKeysFile none
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no

# VERBOSE logs the certificate key ID and serial on every login: the key ID
# carries the Vault token's display name (the operator), so the target's own
# log says who connected, not just "labadmin".
LogLevel VERBOSE

# No tunnels or agent forwarding through a brokered admin session.
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
ClientAliveInterval 60
