<?xml version="1.0" encoding="UTF-8"?>
<!-- Creates a campaign from the definition AND opens review stage 1 in the
     same run (observed on midPoint 4.10.4: the task closes with the campaign
     already in state inReviewStage, cases and work items created). This is
     the handler-based task from midPoint's "Automated campaign scheduling"
     page, run once here instead of on a schedule. -->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      oid="c0471e00-0000-4000-8000-000000000501">
    <name>Contoso: create campaign and open stage 1</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="UserType"/>
    <executionState>runnable</executionState>
    <objectRef oid="c0471e00-0000-4000-8000-000000000401" type="AccessCertificationDefinitionType"/>
    <handlerUri>http://midpoint.evolveum.com/xml/ns/public/certification/task/campaign-creation/handler-3</handlerUri>
    <binding>loose</binding>
</task>
