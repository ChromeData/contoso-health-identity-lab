{
  "rule": "app-credential-added",
  "about": "Complements the itdr-cases.json rows (first secret, SP certificate, first FIC, second secret, IaC by servicePrincipalId, three negatives): a secret on a service principal that already had a certificate, two keys in one write, a FIC added next to an existing one, the CI apply identity matched by appId (Low), the IaC display name on another app (IacNameSpoof, High), the target picked by TYPE when a User entry comes first in TargetResources, a FIC list that was only reordered (no addition) and the look-back edge.",
  "defaults": {
    "AuditLogs": {
      "Category": "ApplicationManagement", "Result": "success", "CorrelationId": "cccccccc-cccc-cccc-cccc-cccccccccccc",
      "InitiatedBy": {"user": {"id": "11111111-1111-1111-1111-111111111111", "displayName": null,
                               "userPrincipalName": "mallory.admin@contosohealthlab.onmicrosoft.com",
                               "ipAddress": "203.0.113.10", "roles": []}}
    }
  },
  "cases": [
    {
      "id": "sp-secret-next-to-existing-cert",
      "kind": "positive",
      "label": "A client secret added on the SERVICE PRINCIPAL that already carried a certificate: ClientSecret, not the first credential, High",
      "tables": {"AuditLogs": [{
        "OperationName": "Add service principal credentials",
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "ServicePrincipal",
          "modifiedProperties": [
            {"displayName": "KeyDescription",
             "oldValue": "[\"[KeyIdentifier=22222222-2222-2222-2222-222222222222,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=sp-cert]\"]",
             "newValue": "[\"[KeyIdentifier=22222222-2222-2222-2222-222222222222,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=sp-cert]\",\"[KeyIdentifier=33333333-3333-3333-3333-333333333333,KeyType=Password,KeyUsage=Verify,DisplayName=sp-secret]\"]"},
            {"displayName": "Included Updated Properties", "oldValue": null, "newValue": "\"KeyDescription\""}
          ]}]
      }]},
      "expect": [{"Severity": "High", "TargetType": "ServicePrincipal", "TargetName": "Clinical Portal",
                  "TargetObjectId": "77777777-7777-7777-7777-777777777777", "CredentialKind": "ClientSecret",
                  "KeyTypes": ["Password"], "AddedCount": 1, "FirstCredential": false, "IsIac": false, "IacNameSpoof": false,
                  "Actor": "mallory.admin@contosohealthlab.onmicrosoft.com", "ActorObjectId": "11111111-1111-1111-1111-111111111111",
                  "ActorIp": "203.0.113.10"}],
      "expectRows": 1
    },
    {
      "id": "two-keys-in-one-write",
      "kind": "positive",
      "label": "A secret AND a certificate added to an empty app registration in one write: AddedCount 2, both key types, first credential, Medium",
      "tables": {"AuditLogs": [{
        "OperationName": "Update application – Certificates and secrets management ",
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "Application",
          "modifiedProperties": [
            {"displayName": "KeyDescription", "oldValue": "[]",
             "newValue": "[\"[KeyIdentifier=33333333-3333-3333-3333-333333333333,KeyType=Password,KeyUsage=Verify,DisplayName=portal-secret]\",\"[KeyIdentifier=55555555-5555-5555-5555-555555555555,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=portal-cert]\"]"},
            {"displayName": "Included Updated Properties", "oldValue": null, "newValue": "\"KeyDescription\""}
          ]}]
      }]},
      "expect": [{"Severity": "Medium", "TargetType": "Application", "CredentialKind": "ClientSecret",
                  "KeyTypes": ["Password", "AsymmetricX509Cert"], "AddedCount": 2, "FirstCredential": true}]
    },
    {
      "id": "fic-added-next-to-existing",
      "kind": "positive",
      "label": "A second federated identity credential (a feature branch allowed to mint tokens) next to the prod one: only the new subject counts, High",
      "tables": {"AuditLogs": [{
        "OperationName": "Update application",
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "Application",
          "modifiedProperties": [
            {"displayName": "FederatedIdentityCredentials",
             "oldValue": "[{\"Name\":\"gh-main\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:environment:prod\",\"Audiences\":[\"api://AzureADTokenExchange\"]}]",
             "newValue": "[{\"Name\":\"gh-main\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:environment:prod\",\"Audiences\":[\"api://AzureADTokenExchange\"]},{\"Name\":\"gh-feature\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:ref:refs/heads/feature/backdoor\",\"Audiences\":[\"api://AzureADTokenExchange\"]}]"},
            {"displayName": "Included Updated Properties", "oldValue": null, "newValue": "\"FederatedIdentityCredentials\""}
          ]}]
      }]},
      "expect": [{"Severity": "High", "CredentialKind": "FederatedIdentityCredential", "AddedCount": 1, "FirstCredential": false,
                  "KeyTypes": [], "FicIssuers": ["https://token.actions.githubusercontent.com"],
                  "FicSubject": ["repo:contoso-health/clinical-portal:ref:refs/heads/feature/backdoor"]}]
    },
    {
      "id": "cert-by-iac-app-id",
      "kind": "positive",
      "label": "The CI apply identity, matched by its appId alone (IacPrincipalIds rendered), rotates the app certificate: Low; Actor and ActorIp from InitiatedBy.app",
      "lets": {"IacPrincipalIds": ["66666666-6666-6666-6666-666666666666"]},
      "tables": {"AuditLogs": [{
        "OperationName": "Update application – Certificates and secrets management ",
        "InitiatedBy": {"app": {"appId": "66666666-6666-6666-6666-666666666666", "displayName": "gh-oidc-entra-apply (write)",
                                "servicePrincipalId": "44444444-4444-4444-4444-444444444444", "servicePrincipalName": null,
                                "ipAddress": "198.51.100.7"}},
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "Application",
          "modifiedProperties": [
            {"displayName": "KeyDescription",
             "oldValue": "[\"[KeyIdentifier=22222222-2222-2222-2222-222222222222,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=portal-cert-2025]\"]",
             "newValue": "[\"[KeyIdentifier=22222222-2222-2222-2222-222222222222,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=portal-cert-2025]\",\"[KeyIdentifier=55555555-5555-5555-5555-555555555555,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=portal-cert-2026]\"]"},
            {"displayName": "Included Updated Properties", "oldValue": null, "newValue": "\"KeyDescription\""}
          ]}]
      }]},
      "expect": [{"Severity": "Low", "IsIac": true, "IacNameSpoof": false, "CredentialKind": "Certificate", "KeyTypes": ["AsymmetricX509Cert"],
                  "Actor": "gh-oidc-entra-apply (write)", "ActorUpn": "", "ActorApp": "gh-oidc-entra-apply (write)",
                  "ActorAppSpId": "44444444-4444-4444-4444-444444444444", "ActorIp": "198.51.100.7"}]
    },
    {
      "id": "iac-display-name-on-another-app",
      "kind": "positive",
      "label": "An app that only CARRIES the IaC display name (ids not in the rendered list) adds an app secret: IacNameSpoof, High instead of Medium",
      "lets": {"IacPrincipalIds": ["44444444-4444-4444-4444-444444444444"]},
      "tables": {"AuditLogs": [{
        "OperationName": "Update application – Certificates and secrets management ",
        "InitiatedBy": {"app": {"appId": "99999999-9999-9999-9999-999999999999", "displayName": "gh-oidc-entra-apply (write)",
                                "servicePrincipalId": "88888888-8888-8888-8888-888888888888", "servicePrincipalName": null}},
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "Application",
          "modifiedProperties": [
            {"displayName": "KeyDescription", "oldValue": "[]",
             "newValue": "[\"[KeyIdentifier=33333333-3333-3333-3333-333333333333,KeyType=Password,KeyUsage=Verify,DisplayName=portal-secret]\"]"}
          ]}]
      }]},
      "expect": [{"Severity": "High", "IsIac": false, "IacNameSpoof": true, "TargetType": "Application", "CredentialKind": "ClientSecret",
                  "ActorApp": "gh-oidc-entra-apply (write)", "ActorAppSpId": "88888888-8888-8888-8888-888888888888"}]
    },
    {
      "id": "target-picked-by-type-not-position",
      "kind": "positive",
      "label": "TargetResources lists a User entry before the Application: the rule picks the Application by type, Medium",
      "tables": {"AuditLogs": [{
        "OperationName": "Update application – Certificates and secrets management ",
        "TargetResources": [
          {"id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "displayName": "Mallory Admin", "type": "User", "modifiedProperties": []},
          {"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "Application",
           "modifiedProperties": [
             {"displayName": "KeyDescription", "oldValue": "[]",
              "newValue": "[\"[KeyIdentifier=33333333-3333-3333-3333-333333333333,KeyType=Password,KeyUsage=Verify,DisplayName=portal-secret]\"]"}
           ]}
        ]
      }]},
      "expect": [{"Severity": "Medium", "TargetType": "Application", "TargetName": "Clinical Portal",
                  "TargetObjectId": "77777777-7777-7777-7777-777777777777", "CredentialKind": "ClientSecret", "AddedCount": 1}],
      "expectRows": 1
    },
    {
      "id": "fic-list-reordered-only",
      "kind": "negative",
      "label": "An 'Update application' whose FederatedIdentityCredentials list is the same two trusts in a different order: nothing added",
      "tables": {"AuditLogs": [{
        "OperationName": "Update application",
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "Application",
          "modifiedProperties": [
            {"displayName": "FederatedIdentityCredentials",
             "oldValue": "[{\"Name\":\"gh-main\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:environment:prod\",\"Audiences\":[\"api://AzureADTokenExchange\"]},{\"Name\":\"gh-staging\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:environment:staging\",\"Audiences\":[\"api://AzureADTokenExchange\"]}]",
             "newValue": "[{\"Name\":\"gh-staging\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:environment:staging\",\"Audiences\":[\"api://AzureADTokenExchange\"]},{\"Name\":\"gh-main\",\"Issuer\":\"https://token.actions.githubusercontent.com\",\"Subject\":\"repo:contoso-health/clinical-portal:environment:prod\",\"Audiences\":[\"api://AzureADTokenExchange\"]}]"},
            {"displayName": "Included Updated Properties", "oldValue": null, "newValue": "\"FederatedIdentityCredentials\""}
          ]}]
      }]}
    },
    {
      "id": "older-than-lookback",
      "kind": "negative",
      "label": "A service-principal secret added 2 h ago is outside the 1 h look-back",
      "tables": {"AuditLogs": [{
        "TimeGenerated": "ago:2h",
        "OperationName": "Add service principal credentials",
        "TargetResources": [{"id": "77777777-7777-7777-7777-777777777777", "displayName": "Clinical Portal", "type": "ServicePrincipal",
          "modifiedProperties": [
            {"displayName": "KeyDescription", "oldValue": "[]",
             "newValue": "[\"[KeyIdentifier=33333333-3333-3333-3333-333333333333,KeyType=Password,KeyUsage=Verify,DisplayName=sp-secret]\"]"}
          ]}]
      }]}
    }
  ]
}
