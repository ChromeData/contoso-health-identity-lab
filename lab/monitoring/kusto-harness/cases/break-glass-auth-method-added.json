              }
            },
            "TargetResources": [
              {
                "id": "22222222-2222-2222-2222-222222222222",
                "displayName": "bg-admin-01",
                "type": "User",
                "userPrincipalName": "dana.okafor@contosohealthlab.onmicrosoft.com"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "other-category",
      "kind": "negative",
      "label": "A group change on bg-admin-01 is not security info",
      "lets": {
