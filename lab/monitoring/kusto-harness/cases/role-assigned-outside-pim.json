{
  "rule": "role-assigned-outside-pim",
  "about": "Standing (active) Entra directory role assignment that did not come through a PIM activation: a direct Core Directory 'Add member to role' / 'Add member to role outside of PIM' not written by MS-PIM, or an ACTIVE assignment made in the PIM blade ('Add member to role in PIM completed (permanent | timebound)'). Activity strings: Learn 'Microsoft Entra audit log activity reference' (Core Directory and PIM sections). Core Directory names the role in the target's modifiedProperties (Role.DisplayName, JSON-quoted); PIM names it as a target of type Role with modifiedProperties []. The IaC apply identity is Medium only when matched by its rendered id (lets IacPrincipalIds); committed empty, nothing is IaC.",
  "defaults": {
    "AuditLogs": {
      "Category": "RoleManagement",
      "LoggedByService": "Core Directory",
      "Result": "success",
      "Identity": "Priya Nair",
      "CorrelationId": "11111111-1111-1111-1111-111111111111",
      "InitiatedBy": {"user": {"id": "22222222-2222-2222-2222-222222222222", "displayName": null, "userPrincipalName": "priya.nair@contosohealthlab.onmicrosoft.com", "ipAddress": "203.0.113.40", "roles": []}}
    }
  },
  "cases": [
    {
      "id": "direct-global-admin-to-user",
      "kind": "positive",
      "label": "Priya gives Noah standing Global Administrator with a direct Core Directory 'Add member to role' (human actor, not MS-PIM): Direct, Tier0, High",
      "tables": {"AuditLogs": [{
        "OperationName": "Add member to role",
        "ActivityDisplayName": "Add member to role",
        "TargetResources": [
          {"id": "33333333-3333-3333-3333-333333333333", "displayName": null, "type": "User", "userPrincipalName": "noah.lindqvist@contosohealthlab.onmicrosoft.com", "groupType": null,
           "modifiedProperties": [
             {"displayName": "Role.ObjectID", "oldValue": null, "newValue": "\"55555555-5555-5555-5555-555555555555\""},
             {"displayName": "Role.DisplayName", "oldValue": null, "newValue": "\"Global Administrator\""},
             {"displayName": "Role.TemplateId", "oldValue": null, "newValue": "\"62e90394-69f5-4237-9190-012177145e10\""}]}
        ]
      }]},
      "expect": [{"Severity": "High", "AssignmentPath": "Direct", "RoleName": "Global Administrator", "RoleTier": "Tier0",
                  "TargetType": "User", "TargetName": "noah.lindqvist@contosohealthlab.onmicrosoft.com",
                  "TargetObjectId": "33333333-3333-3333-3333-333333333333",
                  "Actor": "priya.nair@contosohealthlab.onmicrosoft.com", "ActorUpn": "priya.nair@contosohealthlab.onmicrosoft.com",
                  "ActorObjectId": "22222222-2222-2222-2222-222222222222", "ActorIp": "203.0.113.40",
                  "IsIac": false, "IacNameSpoof": false, "OperationName": "Add member to role",
                  "CorrelationId": "11111111-1111-1111-1111-111111111111"}],
      "expectRows": 1
    },
