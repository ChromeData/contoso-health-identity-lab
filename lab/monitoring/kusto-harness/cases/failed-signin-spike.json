{
  "rule": "failed-signin-spike",
  "about": "10+ CREDENTIAL failures (50126, 50053, 50055, 50056, 50057, 50034) from one IP inside any 10-minute window starting on a 5-minute boundary (hopping, since 2026-11-07, review finding D1). MFA interrupts do not count; the hospital egress ranges (TrustedEgressRanges) drop out of the brute-force shape only.",
  "defaults": {
    "SigninLogs": {
      "TimeGenerated": "ago:7m",
      "IPAddress": "198.51.100.66",
      "ResultType": "50126",
      "AppDisplayName": "Microsoft Office",
      "LocationDetails": {
        "countryOrRegion": "NL"
      }
    }
  },
  "cases": [
    {
      "id": "password-spray",
      "kind": "positive",
      "label": "12 failures from one IP against 12 users: likely password spray",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 12,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com"
          }
        ]
      },
      "expect": [
        {
          "IPAddress": "198.51.100.66",
          "FailedCount": 12,
          "TargetedUsers": 12,
          "Pattern": "likely password spray",
          "Country": "NL",
          "ErrorCodes": [
            "50126"
          ]
        }
      ],
      "expectRows": 1
    },
    {
      "id": "brute-force",
      "kind": "positive",
      "label": "10 failures from one IP against one user (exactly the threshold): likely brute force",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 10,
            "UserPrincipalName": "dana.okafor@contosohealthlab.onmicrosoft.com"
          }
        ]
      },
      "expect": [
        {
          "FailedCount": 10,
          "TargetedUsers": 1,
          "Pattern": "likely brute force"
        }
      ]
    },
    {
      "id": "spray-of-five-users",
      "kind": "positive",
      "label": "10 failures over exactly 5 users is already a spray",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 5,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com"
          },
          {
            "_repeat": 5,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com",
            "ResultType": "50053"
          }
        ]
      },
      "expect": [
        {
          "FailedCount": 10,
          "TargetedUsers": 5,
          "Pattern": "likely password spray",
          "ErrorCodes": [
            "50126",
            "50053"
          ]
        }
      ]
    },
    {
      "id": "below-threshold",
      "kind": "negative",
      "label": "9 failures from one IP",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 9,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com"
          }
        ]
      }
    },
    {
      "id": "successes-do-not-count",
      "kind": "negative",
      "label": "12 SUCCESSFUL sign-ins (ResultType 0) from one IP",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 12,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com",
            "ResultType": "0"
          }
        ]
      }
    },
    {
      "id": "split-across-two-ips",
      "kind": "negative",
      "label": "12 failures split 6 + 6 across two source IPs",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 6,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com"
          },
          {
            "_repeat": 6,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com",
            "IPAddress": "198.51.100.67"
          }
        ]
      }
    },
    {
      "id": "older-than-lookback",
      "kind": "negative",
      "label": "A 12-failure burst 2 h ago",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 12,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com",
            "TimeGenerated": "ago:2h"
          }
        ]
      }
    },
    {
      "id": "burst-straddles-a-boundary",
      "kind": "positive",
      "label": "5 failures at -12 min and 5 at -9 min: 3 minutes apart, so always inside one hopping window (the old tumbling bins could split them 5 + 5 and miss)",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 5,
            "UserPrincipalName": "dana.okafor@contosohealthlab.onmicrosoft.com",
            "TimeGenerated": "ago:12m"
          },
          {
            "_repeat": 5,
            "UserPrincipalName": "dana.okafor@contosohealthlab.onmicrosoft.com",
            "TimeGenerated": "ago:9m"
          }
        ]
      },
      "expect": [
        {
          "FailedCount": 10,
          "Pattern": "likely brute force"
        }
      ],
      "expectRows": 1
    },
    {
      "id": "mfa-interrupts-do-not-count",
      "kind": "negative",
      "label": "12 MFA-required interrupts (50074, 50076) from one IP are not credential failures",
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 6,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com",
            "ResultType": "50074"
          },
          {
            "_repeat": 6,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com",
            "ResultType": "50076"
          }
        ]
      }
    },
    {
      "id": "trusted-egress-brute-force-dropped",
      "kind": "negative",
      "label": "10 failures for one user from the hospital's own NAT range: normal retries, not alerted",
      "lets": {
        "TrustedEgressRanges": [
          "198.51.100.0/24"
        ]
      },
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 10,
            "UserPrincipalName": "dana.okafor@contosohealthlab.onmicrosoft.com"
          }
        ]
      }
    },
    {
      "id": "trusted-egress-spray-still-alerts",
      "kind": "positive",
      "label": "A spray (12 users) from the hospital's own NAT range still alerts",
      "lets": {
        "TrustedEgressRanges": [
          "198.51.100.0/24"
        ]
      },
      "tables": {
        "SigninLogs": [
          {
            "_repeat": 12,
            "UserPrincipalName": "user{i}@contosohealthlab.onmicrosoft.com"
          }
        ]
      },
      "expect": [
        {
          "Pattern": "likely password spray",
          "FailedCount": 12
        }
      ],
      "expectRows": 1
    }
  ]
}
