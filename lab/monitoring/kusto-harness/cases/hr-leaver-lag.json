    {"id": "skipped-run-or-late-row-still-alerts", "kind": "positive", "label": "AD disabled 40 minutes ago and Entra ID still enabled: the 15-minute run that would have judged it was skipped (or the row arrived late). The 45-minute look-back still alerts (review of #233)", "tables": {"AADProvisioningLogs": [{"TimeGenerated": "ago:40m", "ServicePrincipal": "{\"Id\": \"x\", \"Name\": \"Contoso HR Inbound Provisioning\"}", "Action": "Update", "SourceIdentity": "{\"Id\": \"400105\", \"Name\": \"\"}", "TargetIdentity": "{\"Id\": \"eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee\", \"Name\": \"\"}", "ProvisioningStatusInfo": "{\"Status\": \"success\"}", "CycleId": "c1", "ModifiedProperties": "[{\"displayName\": \"accountDisabled\", \"oldValue\": null, \"newValue\": \"True\"}, {\"displayName\": \"parentDistinguishedName\", \"oldValue\": null, \"newValue\": \"OU=Disabled,DC=corp,DC=contosohealthlab,DC=com\"}]"}]}, "expect": [{"AdObjectGuid": "eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee", "EmployeeId": "400105", "Severity": "High", "Reason": "AD disabled, Entra ID still enabled after 15 minutes"}], "expectRows": 1}
