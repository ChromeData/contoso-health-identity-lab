{
  "rule": "dormant-privileged-account-reactivation",
  "about": "A privileged account (adm-* / tier0-admin-NN naming, or a rendered PrivilegedUserIds object id) with no successful sign-in in either sign-in table for the 14-day look-back signs in interactively in the last hour. Ported from Sentinel-Privileged-Access with its decoys (10-day gap, unprivileged account, failed sign-in), plus the lab's own: non-interactive refreshes count as activity, break-glass is left to break-glass-signin, a new account is Medium.",
  "defaults": {
    "SigninLogs": {
      "UserPrincipalName": "adm-ava.lin@contosohealthlab.onmicrosoft.com",
      "UserId": "11111111-1111-1111-1111-111111111111",
      "IPAddress": "203.0.113.10",
      "AppDisplayName": "Azure Portal",
      "ResultType": "0",
      "TimeGenerated": "ago:20m"
    },
    "AADNonInteractiveUserSignInLogs": {
      "UserPrincipalName": "adm-ava.lin@contosohealthlab.onmicrosoft.com",
      "UserId": "11111111-1111-1111-1111-111111111111",
      "IPAddress": "203.0.113.10",
      "AppDisplayName": "Azure Portal",
      "ResultType": "0",
      "TimeGenerated": "ago:20m"
    },
    "AuditLogs": {
      "OperationName": "Add user",
      "Result": "success",
      "TimeGenerated": "ago:2d",
      "TargetResources": [
        {
          "id": "11111111-1111-1111-1111-111111111111",
          "type": "User",
          "userPrincipalName": "adm-ava.lin@contosohealthlab.onmicrosoft.com"
        }
      ]
    }
  },
  "cases": [
    {
      "id": "quiet-admin-wakes",
      "kind": "positive",
      "label": "adm-ava.lin: no sign-in in 14 days, then an interactive success now: High",
      "tables": {
        "SigninLogs": [
          {}
        ]
      },
      "expect": [
        {
          "Severity": "High",
          "UserPrincipalName": "adm-ava.lin@contosohealthlab.onmicrosoft.com",
          "NewAccount": false,
          "SignIns": 1,
          "IPAddress": "203.0.113.10"
        }
      ],
      "expectRows": 1
    },
    {
      "id": "last-signin-before-the-look-back",
      "kind": "positive",
      "label": "Signed in 15 days ago (outside the 14-day look-back) and again now: still dormant",
      "tables": {
        "SigninLogs": [
          {
            "TimeGenerated": "ago:15d",
            "IPAddress": "198.51.100.1"
          },
          {}
        ]
      },
      "expect": [
        {
          "Severity": "High",
          "SignIns": 1,
          "IPAddress": "203.0.113.10"
        }
      ],
      "expectRows": 1
    },
    {
      "id": "two-signins-this-hour",
      "kind": "positive",
      "label": "Two interactive successes inside the judge hour and nothing before: one row, SignIns 2, the first sign-in's IP",
      "tables": {
        "SigninLogs": [
          {
            "TimeGenerated": "ago:50m",
            "IPAddress": "203.0.113.11"
          },
          {
            "TimeGenerated": "ago:10m"
          }
        ]
      },
      "expect": [
        {
          "SignIns": 2,
          "IPAddress": "203.0.113.11"
        }
      ],
      "expectRows": 1
    },
    {
      "id": "tier0-admin-naming",
      "kind": "positive",
      "label": "tier0-admin-01 is privileged by naming",
      "tables": {
        "SigninLogs": [
          {
            "UserPrincipalName": "tier0-admin-01@contosohealthlab.onmicrosoft.com",
            "UserId": "22222222-2222-2222-2222-222222222222"
          }
        ]
      },
      "expect": [
        {
          "Severity": "High",
          "UserPrincipalName": "tier0-admin-01@contosohealthlab.onmicrosoft.com",
          "PrivilegedById": false
        }
      ],
      "expectRows": 1
    },
    {
      "id": "privileged-by-rendered-id",
      "kind": "positive",
      "label": "helen.carter has a staff-style name but her object id is in the rendered PrivilegedUserIds",
      "lets": {
        "PrivilegedUserIds": [
          "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
        ]
      },
      "tables": {
        "SigninLogs": [
          {
            "UserPrincipalName": "helen.carter@contosohealthlab.onmicrosoft.com",
            "UserId": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
          }
        ]
      },
      "expect": [
        {
          "Severity": "High",
          "UserId": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
          "PrivilegedById": true
        }
      ],
      "expectRows": 1
    },
    {
      "id": "new-admin-first-signin",
      "kind": "positive",
      "label": "adm-ava.lin was created 2 days ago (Add user in AuditLogs): her first sign-in is Medium, not High",
      "tables": {
        "AuditLogs": [
          {}
        ],
        "SigninLogs": [
          {}
        ]
      },
      "expect": [
        {
          "Severity": "Medium",
          "NewAccount": true
        }
      ],
      "expectRows": 1
    },
    {
      "id": "active-admin-10-day-gap",
      "kind": "negative",
      "label": "DECOY (from the old repo): signed in 10 days ago and now - a normal gap",
      "tables": {
        "SigninLogs": [
          {
            "TimeGenerated": "ago:10d"
          },
          {}
        ]
      }
    },
    {
      "id": "non-interactive-refresh-is-activity",
      "kind": "negative",
      "label": "DECOY: no interactive sign-in for 14 days, but a token refresh 5 days ago: the account had a live session, so it is not dormant",
      "tables": {
        "AADNonInteractiveUserSignInLogs": [
          {
            "TimeGenerated": "ago:5d"
          }
        ],
        "SigninLogs": [
          {}
        ]
      }
    },
    {
      "id": "only-non-interactive-now",
      "kind": "negative",
      "label": "DECOY: a non-interactive refresh in the last hour is not someone signing in",
      "tables": {
        "AADNonInteractiveUserSignInLogs": [
          {}
        ]
      }
    },
    {
      "id": "staff-account-not-privileged",
      "kind": "negative",
      "label": "DECOY (from the old repo): dana.okafor is not privileged, however long the gap",
      "tables": {
        "SigninLogs": [
          {
            "UserPrincipalName": "dana.okafor@contosohealthlab.onmicrosoft.com",
            "UserId": "33333333-3333-3333-3333-333333333333"
          }
        ]
      }
    },
    {
      "id": "failed-signin-is-not-waking",
      "kind": "negative",
      "label": "DECOY (from the old repo): a failed sign-in (50126) against a quiet admin is a spray, not a reactivation",
      "tables": {
        "SigninLogs": [
          {
            "ResultType": "50126"
          }
        ]
      }
    },
    {
      "id": "break-glass-left-to-its-own-rule",
      "kind": "negative",
      "label": "DECOY: bg-admin-01 is quiet by design and break-glass-signin already alerts on every sign-in, even when its id is rendered in",
      "lets": {
        "PrivilegedUserIds": [
          "44444444-4444-4444-4444-444444444444"
        ]
      },
      "tables": {
        "SigninLogs": [
          {
            "UserPrincipalName": "bg-admin-01@contosohealthlab.onmicrosoft.com",
            "UserId": "44444444-4444-4444-4444-444444444444"
          }
        ]
      }
    },
    {
      "id": "woke-two-hours-ago",
      "kind": "negative",
      "label": "DECOY: the wake-up sign-in was 2 hours ago, so the previous hourly run judged it; this run must not repeat it",
      "tables": {
        "SigninLogs": [
          {
            "TimeGenerated": "ago:2h"
          }
        ]
      }
    }
  ]
}
