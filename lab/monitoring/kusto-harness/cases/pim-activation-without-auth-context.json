{
  "rule": "pim-activation-without-auth-context",
  "about": "A Tier-0 PIM activation (PIM-Tier0-Security-Admins / PIM-Tier0-CA-Admins) with no sign-in that satisfied authentication context c1 in the 30 minutes before the request. AuthenticationContextClassReferences is a STRING in both sign-in tables (Learn); its JSON shape [{id, detail}] follows the Graph signIn property (verify: in the tenant). ContextPolicies is committed empty, so only the 'no step-up' verdict can fire here. Every case has its OWN user (object id, UPN, IP) and its own correlation ids: the Kusto harness isolates cases anyway, but the Splunk replay (lab/splunk/replay-synthetic.py) lands every case in one index, and a shared user would let a negative case's c1 sign-in satisfy a positive case's activation. The 16 repeated-digit placeholder GUIDs are spent on 9 users, 3 groups and the CA policy, so the correlation ids are plain synthetic strings (no rule joins on CorrelationId).",
  "defaults": {
    "AuditLogs": {
      "LoggedByService": "PIM", "Category": "GroupManagement", "Result": "success", "Identity": "MS-PIM"
    },
    "SigninLogs": {
      "AppDisplayName": "Azure Portal", "ResultType": "0",
      "AuthenticationContextClassReferences": "[{\"id\":\"c1\",\"detail\":\"required\"}]",
      "ConditionalAccessPolicies": [{"id": "dddddddd-dddd-dddd-dddd-dddddddddddd", "displayName": "CA021 - Tier-0 activation step-up", "result": "success"}],
      "TimeGenerated": "ago:13m"
    },
    "AADNonInteractiveUserSignInLogs": {
      "AppDisplayName": "Azure Portal", "ResultType": "0",
      "AuthenticationContextClassReferences": "[{\"id\":\"c1\",\"detail\":\"previouslySatisfied\"}]",
      "ConditionalAccessPolicies": "[{\"id\":\"dddddddd-dddd-dddd-dddd-dddddddddddd\",\"displayName\":\"CA021 - Tier-0 activation step-up\",\"result\":\"success\"}]",
      "TimeGenerated": "ago:13m"
    }
  },
  "cases": [
    {
      "id": "no-step-up-at-all",
      "kind": "positive",
      "label": "Sam's requested and completed activation of PIM-Tier0-Security-Admins with no c1 sign-in",
      "tables": {"AuditLogs": [
        {"OperationName": "Add member to role requested (PIM activation)", "ActivityDisplayName": "Add member to role requested (PIM activation)", "TimeGenerated": "ago:12m",
         "CorrelationId": "pim-noctx-01-audit",
         "InitiatedBy": {"user": {"id": "11111111-1111-1111-1111-111111111111", "userPrincipalName": "sam.rivera@contosohealthlab.onmicrosoft.com", "ipAddress": "203.0.113.101"}},
         "TargetResources": [
           {"id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "displayName": "PIM-Tier0-Security-Admins", "type": "Group"},
           {"id": "11111111-1111-1111-1111-111111111111", "displayName": "Sam Rivera", "type": "User", "userPrincipalName": "sam.rivera@contosohealthlab.onmicrosoft.com"}]},
        {"OperationName": "Add member to role completed (PIM activation)", "ActivityDisplayName": "Add member to role completed (PIM activation)", "TimeGenerated": "ago:10m",
         "CorrelationId": "pim-noctx-01-audit",
         "InitiatedBy": {"user": {"id": "11111111-1111-1111-1111-111111111111", "userPrincipalName": "sam.rivera@contosohealthlab.onmicrosoft.com", "ipAddress": "203.0.113.101"}},
         "TargetResources": [
           {"id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "displayName": "PIM-Tier0-Security-Admins", "type": "Group"},
           {"id": "11111111-1111-1111-1111-111111111111", "displayName": "Sam Rivera", "type": "User", "userPrincipalName": "sam.rivera@contosohealthlab.onmicrosoft.com"}]}
      ]},
      "expect": [{"Severity": "High", "Verdict": "No sign-in satisfied authentication context c1 before this activation",
                  "ElevatedTo": "PIM-Tier0-Security-Admins", "StepUpSignIns": 0, "ActorIp": "203.0.113.101",
                  "UserId": "11111111-1111-1111-1111-111111111111",
                  "UserPrincipalName": "sam.rivera@contosohealthlab.onmicrosoft.com",
                  "CorrelationId": "pim-noctx-01-audit",
                  "PolicyCheck": "skipped - set ContextPolicies to the CA policy targeting the context"}],
      "expectRows": 1
    },
