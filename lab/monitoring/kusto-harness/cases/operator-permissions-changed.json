            "TargetResources": [
              {
                "id": "88888888-8888-8888-8888-888888888888",
                "displayName": "Contoso Lab Operator (local Mac, certificate)",
                "type": "ServicePrincipal",
                "modifiedProperties": [
                  {
                    "displayName": "KeyDescription",
                    "oldValue": "[]",
                    "newValue": "[\"[KeyIdentifier=x,KeyType=AsymmetricX509Cert,KeyUsage=Verify,DisplayName=CN=op]\"]"
                  }
