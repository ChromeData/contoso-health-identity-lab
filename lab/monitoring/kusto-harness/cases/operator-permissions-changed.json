                "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
                "displayName": "Microsoft Graph",
                "type": "ServicePrincipal",
                "modifiedProperties": [
                  {
                    "displayName": "AppRole.Value",
                    "oldValue": null,
                    "newValue": "\"Directory.ReadWrite.All\""
                  },
                  {
                    "displayName": "ServicePrincipal.ObjectID",
                    "oldValue": null,
                    "newValue": "\"88888888-8888-8888-8888-888888888888\""
                  }
                ]
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "Severity": "Medium"
        }
      ]
    },
    {
      "id": "grant-to-another-app",
      "kind": "negative",
      "label": "An app role granted to another app",
      "lets": {
        "OperatorPrincipalIds": [
          "88888888-8888-8888-8888-888888888888"
