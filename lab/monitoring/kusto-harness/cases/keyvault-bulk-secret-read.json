{
  "rule": "keyvault-bulk-secret-read",
  "about": "Key Vault SecretGet rows as AzureDiagnostics stores them (columns read live on loga-idlab, 2026-11-06). The caller is usually a managed identity with no UPN, so the rule keys on identity_claim_oid_g first. Ported from Sentinel-Privileged-Access with its decoys (low volume, SecretList), plus: two quiet identities must not merge into one bucket, 404s are not reads, refused reads are their own signal, the baseline raises the threshold.",
  "defaults": {
    "AzureDiagnostics": {
      "ResourceProvider": "MICROSOFT.KEYVAULT",
      "Category": "AuditEvent",
      "ResourceType": "VAULTS",
      "Resource": "KV-IDLAB-20F1",
      "ResourceGroup": "RG-IDENTITY-LAB",
      "SubscriptionId": "22222222-2222-2222-2222-222222222222",
      "ResourceId": "/SUBSCRIPTIONS/22222222-2222-2222-2222-222222222222/RESOURCEGROUPS/RG-IDENTITY-LAB/PROVIDERS/MICROSOFT.KEYVAULT/VAULTS/KV-IDLAB-20F1",
      "OperationName": "SecretGet",
      "ResultType": "Success",
      "ResultSignature": "OK",
      "httpStatusCode_d": 200,
      "identity_claim_oid_g": "11111111-1111-1111-1111-111111111111",
      "identity_claim_appid_g": "55555555-5555-5555-5555-555555555555",
      "identity_claim_idtyp_s": "app",
      "identity_claim_upn_s": "",
      "CallerIPAddress": "10.10.2.4",
      "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets/uami-app-secret/0123456789abcdef0123456789abcdef",
      "requestUri_s": "https://kv-idlab-20f1.vault.azure.net/secrets/uami-app-secret/?api-version=7.4",
      "TimeGenerated": "ago:10m"
    }
  },
  "cases": [
    {
      "id": "mi-harvests-many-secrets",
      "kind": "positive",
      "label": "A managed identity reads 30 different secrets in 10 minutes: bulk read, High",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 30,
            "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets/secret-{i}/0123456789abcdef0123456789abcdef"
          }
        ]
      },
      "expect": [
        {
          "Severity": "High",
          "Signal": "bulk read",
          "CallerId": "11111111-1111-1111-1111-111111111111",
          "CallerObjectId": "11111111-1111-1111-1111-111111111111",
          "CallerType": "app",
          "Reads": 30,
          "Secrets": 30,
          "Denied": 0
        }
      ],
      "expectRows": 1
    },
    {
      "id": "one-secret-retry-loop",
      "kind": "positive",
      "label": "The same identity reads its one secret 25 times: over the floor of 20, one secret, so Medium",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 25
          }
        ]
      },
      "expect": [
        {
          "Severity": "Medium",
          "Signal": "bulk read",
          "Reads": 25,
          "Secrets": 1
        }
      ],
      "expectRows": 1
    },
    {
      "id": "user-caller",
      "kind": "positive",
      "label": "A user (idtyp user, UPN present) reads 6 secrets 4 times each: keyed on the user's object id, CallerUpn shown, High",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 24,
            "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets/shared-{i}/0123456789abcdef0123456789abcdef",
            "identity_claim_oid_g": "66666666-6666-6666-6666-666666666666",
            "identity_claim_appid_g": "04b07795-8ddb-461a-bbee-02f9e1bf7b46",
            "identity_claim_idtyp_s": "user",
            "identity_claim_upn_s": "adm-raj.patel@contosohealthlab.onmicrosoft.com"
          }
        ]
      },
      "expect": [
        {
          "CallerId": "66666666-6666-6666-6666-666666666666",
          "CallerUpn": "adm-raj.patel@contosohealthlab.onmicrosoft.com",
          "Reads": 24
        }
      ],
      "expectRows": 1
    },
    {
      "id": "denied-burst",
      "kind": "positive",
      "label": "The managed identity tries 25 secrets it may not read (403, the ABAC condition held): denied burst, High",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 25,
            "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets/secret-{i}/0123456789abcdef0123456789abcdef",
            "httpStatusCode_d": 403,
            "ResultType": "Forbidden",
            "ResultSignature": "Forbidden"
          }
        ]
      },
      "expect": [
        {
          "Severity": "High",
          "Signal": "denied burst",
          "Reads": 0,
          "Denied": 25,
          "DeniedSecrets": 25
        }
      ],
      "expectRows": 1
    },
    {
      "id": "under-the-floor",
      "kind": "negative",
      "label": "DECOY (from the old repo): 15 reads is under the floor of 20, whatever the baseline",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 15
          }
        ]
      }
    },
    {
      "id": "two-quiet-identities-not-merged",
      "kind": "negative",
      "label": "DECOY: two managed identities, no UPN, 12 reads each. Keyed on UPN (the old rule) they were one empty-name caller with 24 reads and fired; keyed on object id each is under the floor",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 12
          },
          {
            "_repeat": 12,
            "identity_claim_oid_g": "77777777-7777-7777-7777-777777777777",
            "identity_claim_appid_g": "88888888-8888-8888-8888-888888888888"
          }
        ]
      }
    },
    {
      "id": "same-reads-no-baseline",
      "kind": "positive",
      "label": "The same 21 reads from an identity with no history: the floor of 20 is the threshold, so it fires (the pair to within-own-baseline)",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 21
          }
        ]
      },
      "expect": [
        {
          "Severity": "Medium",
          "Reads": 21,
          "BaselineReads": 0,
          "ReadThreshold": 20
        }
      ],
      "expectRows": 1
    },
    {
      "id": "within-own-baseline",
      "kind": "negative",
      "label": "DECOY: 21 reads this hour (over the floor of 20) from an identity that read 1450 times in the 335 hours before: mean 4.33 an hour, threshold 21.6, so not 5x its own normal. Baseline rows carry short strings to keep the case small",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 1450,
            "TimeGenerated": "ago:3d",
            "id_s": "/secrets/s/",
            "requestUri_s": "",
            "ResourceId": "",
            "CallerIPAddress": "",
            "ResourceGroup": "",
            "SubscriptionId": "",
            "ResultSignature": ""
          },
          {
            "_repeat": 21
          }
        ]
      }
    },
    {
      "id": "secret-list-not-counted",
      "kind": "negative",
      "label": "DECOY (from the old repo): 80 SecretList calls list names, they do not read values",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 80,
            "OperationName": "SecretList",
            "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets"
          }
        ]
      }
    },
    {
      "id": "not-found-is-not-a-read",
      "kind": "negative",
      "label": "DECOY: 30 SecretGet calls for a secret that does not exist (logged ResultType Success, HTTP 404) read nothing",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 30,
            "httpStatusCode_d": 404,
            "ResultSignature": "Not Found"
          }
        ]
      }
    },
    {
      "id": "denied-under-the-floor",
      "kind": "negative",
      "label": "DECOY: 10 refused reads is under the denied floor of 20",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 10,
            "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets/secret-{i}/0123456789abcdef0123456789abcdef",
            "httpStatusCode_d": 403,
            "ResultType": "Forbidden",
            "ResultSignature": "Forbidden"
          }
        ]
      }
    },
    {
      "id": "burst-outside-the-hour",
      "kind": "negative",
      "label": "DECOY: a 50-read burst 3 hours ago was judged by an earlier run",
      "tables": {
        "AzureDiagnostics": [
          {
            "_repeat": 50,
            "id_s": "https://kv-idlab-20f1.vault.azure.net/secrets/secret-{i}/0123456789abcdef0123456789abcdef",
            "TimeGenerated": "ago:3h"
          }
        ]
      }
    }
  ]
}
