{
  "rule": "pim-group-member-added-outside-pim",
  "about": "A member added to a role-holding / PIM-governed group outside a PIM activation: a Core Directory 'Add member to group' not written by MS-PIM, or an ACTIVE PIM-for-Groups membership ('Add member to role in PIM completed (permanent | timebound)'). Activity strings: Learn 'Microsoft Entra audit log activity reference' (Core Directory and PIM sections). Core Directory's shape names the group in the member's modifiedProperties (Group.ObjectID / Group.DisplayName, JSON-quoted); PIM's shape names it as a target of type Group. Run standalone (every id list empty) the lab's groups are matched by name; a case may render PrivilegedGroupIds / IacPrincipalIds. Break-Glass-Admins is High whoever the actor is; the Azure PIM group's standing members are its design (AzurePimEligibleMember, Medium).",
  "defaults": {
    "AuditLogs": {
      "Category": "GroupManagement",
      "LoggedByService": "Core Directory",
      "Result": "success",
      "Identity": "Tomas Herrera",
      "CorrelationId": "cccccccc-cccc-cccc-cccc-cccccccccccc",
      "InitiatedBy": {"user": {"id": "11111111-1111-1111-1111-111111111111", "displayName": null, "userPrincipalName": "tomas.herrera@contosohealthlab.onmicrosoft.com", "ipAddress": "203.0.113.50", "roles": []}}
    }
  },
  "cases": [
    {
      "id": "direct-add-to-break-glass-admins",
      "kind": "positive",
      "label": "Tomas adds Lena to Break-Glass-Admins with a direct Core Directory 'Add member to group' (group named only in the member's Group.ObjectID / Group.DisplayName properties): Direct, break-glass, High",
      "tables": {"AuditLogs": [{
        "OperationName": "Add member to group",
        "ActivityDisplayName": "Add member to group",
        "TargetResources": [
          {"id": "22222222-2222-2222-2222-222222222222", "displayName": null, "type": "User", "userPrincipalName": "lena.fischer@contosohealthlab.onmicrosoft.com", "groupType": null,
           "modifiedProperties": [
             {"displayName": "Group.ObjectID", "oldValue": null, "newValue": "\"33333333-3333-3333-3333-333333333333\""},
             {"displayName": "Group.DisplayName", "oldValue": null, "newValue": "\"Break-Glass-Admins\""},
             {"displayName": "Group.WellKnownObjectName", "oldValue": null, "newValue": null}]}
        ]
      }]},
      "expect": [{"Severity": "High", "AssignmentPath": "Direct", "GroupName": "Break-Glass-Admins", "GroupId": "33333333-3333-3333-3333-333333333333",
                  "IsBreakGlassGroup": true, "MemberType": "User", "MemberName": "lena.fischer@contosohealthlab.onmicrosoft.com",
                  "MemberId": "22222222-2222-2222-2222-222222222222",
                  "Actor": "tomas.herrera@contosohealthlab.onmicrosoft.com", "ActorUpn": "tomas.herrera@contosohealthlab.onmicrosoft.com",
                  "ActorObjectId": "11111111-1111-1111-1111-111111111111", "ActorIp": "203.0.113.50",
                  "IsIac": false, "IacNameSpoof": false, "OperationName": "Add member to group",
                  "CorrelationId": "cccccccc-cccc-cccc-cccc-cccccccccccc"}],
      "expectRows": 1
    },
