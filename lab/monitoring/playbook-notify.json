{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Contoso Health identity lab - Sentinel incident -> adaptive card in the SOC team's Identity-SecOps channel (Teams connector, posted as the Flow bot) + ServiceNow incident + incident comment. Deployed by lab/scripts/monitoring/Deploy-Playbook.ps1 (the ServiceNow secret comes from Key Vault at deploy time, never from the repo or CI). The Teams connection is OAuth: authorize it once after deploy as the SOC automation account (svc-soc-automation, the team owner), never as a person - lab/scripts/monitoring/authorize-teams-connection.mjs. Sets the ServiceNow correlation_id to the Sentinel incident name (GUID) so playbook-contain.json appends its containment record to the SAME ticket instead of opening a duplicate."
  },
  "parameters": {
    "playbookName": {
      "type": "string",
      "defaultValue": "pb-identity-notify"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "teamsGroupId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Teams team (M365 group) id of the SOC team that owns the Identity-SecOps channel. Not a secret. Empty (or empty teamsChannelId) = skip Teams."
      }
    },
    "teamsChannelId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Channel id (19:...@thread.tacv2) the incident cards go to. Not a secret."
      }
    },
    "snowInstance": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "ServiceNow instance name (devNNNNN). Empty (or empty snowUser/snowPassword) = skip ServiceNow."
      }
    },
    "snowUser": {
      "type": "string",
      "defaultValue": ""
    },
    "snowPassword": {
      "type": "securestring",
      "defaultValue": ""
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "project": "contoso-health-identity-lab",
        "managed_by": "Deploy-Playbook.ps1"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[concat('azuresentinel-', parameters('playbookName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "V1",
      "properties": {
        "displayName": "[concat('Sentinel (managed identity) - ', parameters('playbookName'))]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[concat('teams-', parameters('playbookName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[concat('Teams incident cards (authorize once after deploy, as svc-soc-automation) - ', parameters('playbookName'))]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('playbookName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', concat('azuresentinel-', parameters('playbookName')))]",
        "[resourceId('Microsoft.Web/connections', concat('teams-', parameters('playbookName')))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "teamsGroupId": {
              "type": "String",
              "defaultValue": ""
            },
            "teamsChannelId": {
              "type": "String",
              "defaultValue": ""
            },
            "snowInstance": {
              "type": "String",
              "defaultValue": ""
            },
            "snowUser": {
              "type": "String",
              "defaultValue": ""
            },
            "snowPassword": {
              "type": "SecureString",
              "defaultValue": ""
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Map_severity_to_priority": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@if(equals(triggerBody()?['object']?['properties']?['severity'],'High'),'1',if(equals(triggerBody()?['object']?['properties']?['severity'],'Medium'),'2','3'))"
            },
            "If_Teams_configured": {
              "type": "If",
              "runAfter": {
                "Map_severity_to_priority": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@parameters('teamsGroupId')",
                        ""
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('teamsChannelId')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Compose_incident_card": {
                  "type": "Compose",
                  "inputs": {
                    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                    "type": "AdaptiveCard",
                    "version": "1.4",
                    "body": [
                      {
                        "type": "TextBlock",
                        "size": "Large",
                        "weight": "Bolder",
                        "wrap": true,
                        "text": "@{triggerBody()?['object']?['properties']?['severity']} - @{triggerBody()?['object']?['properties']?['title']}"
                      },
                      {
                        "type": "FactSet",
                        "facts": [
                          {
                            "title": "Incident",
                            "value": "#@{triggerBody()?['object']?['properties']?['incidentNumber']}"
                          },
                          {
                            "title": "Created (UTC)",
                            "value": "@{triggerBody()?['object']?['properties']?['createdTimeUtc']}"
                          },
                          {
                            "title": "Status",
                            "value": "@{triggerBody()?['object']?['properties']?['status']}"
                          }
                        ]
                      },
                      {
                        "type": "TextBlock",
                        "wrap": true,
                        "text": "@{triggerBody()?['object']?['properties']?['description']}"
                      }
                    ],
                    "actions": [
                      {
                        "type": "Action.OpenUrl",
                        "title": "Open in Sentinel",
                        "url": "@{triggerBody()?['object']?['properties']?['incidentUrl']}"
                      }
                    ]
                  }
                },
                "Post_card_to_SOC_channel": {
                  "type": "ApiConnection",
                  "description": "Teams connector 'Post card in a chat or channel' as the Flow bot to the SOC team's Identity-SecOps channel. The connection is OAuth and was authorized once as svc-soc-automation (the team owner); it holds no secret in this template, unlike the Workflows webhook URL it replaces (a bearer credential: anyone holding it could post).",
                  "runAfter": {
                    "Compose_incident_card": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['teams']['connectionId']"
                      }
                    },
                    "method": "post",
                    "body": {
                      "recipient": {
                        "groupId": "@parameters('teamsGroupId')",
                        "channelId": "@parameters('teamsChannelId')"
                      },
                      "messageBody": "@{outputs('Compose_incident_card')}"
                    },
                    "path": "/v1.0/teams/conversation/adaptivecard/poster/Flow bot/location/@{encodeURIComponent('Channel')}"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "If_ServiceNow_configured": {
              "type": "If",
              "runAfter": {
                "Map_severity_to_priority": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@parameters('snowInstance')",
                        ""
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('snowUser')",
                        ""
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('snowPassword')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Create_ServiceNow_incident": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://@{parameters('snowInstance')}.service-now.com/api/now/table/incident",
                    "headers": {
                      "Content-Type": "application/json",
                      "Accept": "application/json"
                    },
                    "authentication": {
                      "type": "Basic",
                      "username": "@parameters('snowUser')",
                      "password": "@parameters('snowPassword')"
                    },
                    "body": {
                      "short_description": "[Sentinel #@{triggerBody()?['object']?['properties']?['incidentNumber']}] @{triggerBody()?['object']?['properties']?['title']}",
                      "description": "@{triggerBody()?['object']?['properties']?['description']}\n\nSeverity: @{triggerBody()?['object']?['properties']?['severity']}\nSentinel incident: @{triggerBody()?['object']?['properties']?['incidentUrl']}",
                      "urgency": "@{outputs('Map_severity_to_priority')}",
                      "impact": "@{outputs('Map_severity_to_priority')}",
                      "category": "inquiry",
                      "correlation_id": "@{triggerBody()?['object']?['name']}",
                      "correlation_display": "Microsoft Sentinel"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  }
                },
                "Comment_ticket_number_on_Sentinel_incident": {
                  "type": "ApiConnection",
                  "runAfter": {
                    "Create_ServiceNow_incident": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/Incidents/Comment",
                    "body": {
                      "incidentArmId": "@triggerBody()?['object']?['id']",
                      "message": "<p>ServiceNow incident @{body('Create_ServiceNow_incident')?['result']?['number']} opened automatically by playbook @{workflow()?['name']}.</p>"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', concat('azuresentinel-', parameters('playbookName')))]",
                "connectionName": "[concat('azuresentinel-', parameters('playbookName'))]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "teams": {
                "connectionId": "[resourceId('Microsoft.Web/connections', concat('teams-', parameters('playbookName')))]",
                "connectionName": "[concat('teams-', parameters('playbookName'))]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
              }
            }
          },
          "teamsGroupId": {
            "value": "[parameters('teamsGroupId')]"
          },
          "teamsChannelId": {
            "value": "[parameters('teamsChannelId')]"
          },
          "snowInstance": {
            "value": "[parameters('snowInstance')]"
          },
          "snowUser": {
            "value": "[parameters('snowUser')]"
          },
          "snowPassword": {
            "value": "[parameters('snowPassword')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('playbookName'))]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('playbookName')), '2019-05-01', 'full').identity.principalId]"
    },
    "teamsConnectionName": {
      "type": "string",
      "value": "[concat('teams-', parameters('playbookName'))]"
    }
  }
}
